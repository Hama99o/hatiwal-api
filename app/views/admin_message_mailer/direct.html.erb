<%# Inline styles ON PURPOSE: email clients strip <style> blocks and linked
    stylesheets, so every style here must stay on the element. Do not move
    them to admin.css — that would break the look of every email sent. %>
<!DOCTYPE html>
<html lang="<%= @admin_email.locale.presence || @user.preferred_language.presence || "en" %>">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= @admin_email.subject %></title>
</head>
<body style="margin:0;padding:0;background-color:#f4f4f7;font-family:'Helvetica Neue',Helvetica,Arial,'Noto Sans Arabic',sans-serif;">
  <table width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:#f4f4f7;padding:40px 0;">
    <tr>
      <td align="center">
        <table width="100%" cellpadding="0" cellspacing="0" border="0" style="max-width:560px;">
          <tr>
            <td align="center" style="padding-bottom:24px;">
              <span style="font-size:22px;font-weight:700;color:#12224F;letter-spacing:-0.5px;">Hatiwal</span>
            </td>
          </tr>
          <tr>
            <td style="background:#ffffff;border-radius:12px;padding:32px 40px;box-shadow:0 2px 8px rgba(0,0,0,0.06);">
              <%# dir="auto": the admin may write in Pashto, Dari or Urdu, which must read right-to-left. %>
              <div dir="auto" style="font-size:15px;line-height:1.6;color:#1f2937;white-space:pre-wrap;"><%= @admin_email.body %></div>
            </td>
          </tr>
          <tr>
            <td align="center" style="padding-top:20px;font-size:12px;color:#9ca3af;">
              Hatiwal — buy and sell locally. You can reply to this email.
              <% if @unsubscribe_url %>
                <br><a href="<%= @unsubscribe_url %>" style="color:#9ca3af;"><%= I18n.t("unsubscribe.email_footer", locale: @admin_email.locale.presence || "en") %></a>
              <% end %>
            </td>
          </tr>
        </table>
      </td>
    </tr>
  </table>
</body>
</html>
