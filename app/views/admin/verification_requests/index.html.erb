<% content_for(:title) { "Verifications" } %>

<header class="hw-page-header">
  <div>
    <h1 class="hw-page-header__title main-content__page-title">Verifications</h1>
    <p class="hw-page-header__subtitle"><%= @kind == "shops" ? "Shops asking for the Verified shop badge (the owner's e-Tazkira + a proof of business)." : "People asking for the Verified badge." %> Every decision is made by hand; waiting requests come oldest first.</p>
  </div>
  <nav class="hw-segmented" aria-label="Kind">
    <%= link_to "Users#{" (#{@waiting_by_kind['users']} waiting)" if @waiting_by_kind['users'].positive?}", admin_verification_requests_path(kind: "users", status: @filter),
          class: "growth-period #{'growth-period--active' if @kind == 'users'}", id: "verification-kind-users" %>
    <%= link_to "Shops#{" (#{@waiting_by_kind['shops']} waiting)" if @waiting_by_kind['shops'].positive?}", admin_verification_requests_path(kind: "shops", status: @filter),
          class: "growth-period #{'growth-period--active' if @kind == 'shops'}", id: "verification-kind-shops" %>
  </nav>
</header>

<nav class="hw-segmented hw-gap-bottom" aria-label="Status" id="verification-filters">
  <% { "waiting" => "Waiting", "approved" => "Approved", "rejected" => "Rejected", "revoked" => "Revoked", "all" => "All" }.each do |key, label| %>
    <%= link_to "#{label} (#{@counts[key]})", admin_verification_requests_path(status: key, kind: @kind),
          class: "growth-period #{'growth-period--active' if @filter == key}", id: "verification-filter-#{key}" %>
  <% end %>
</nav>

<section class="main-content__body main-content__body--flush">
  <% if @requests.any? %>
    <table id="verification-queue">
      <thead>
        <tr><th><%= @kind == "shops" ? "Shop" : "Person" %></th><th>Document</th><th>Status</th><th>Sent</th><th>Decided</th><th></th></tr>
      </thead>
      <tbody>
        <% @requests.each do |r| %>
          <% user = r.subject %>
          <tr>
            <% if r.shop_subject? %>
              <%# SHOP-1: a shop row names the shop and links its owner. %>
              <td class="hw-nowrap" dir="auto">🏪 <%= user.name %> <span class="hw-text-muted">#<%= user.id %> · owner <%= link_to user.owner.full_name, admin_user_path(user.owner) %></span></td>
            <% else %>
            <td class="hw-nowrap" dir="auto"><%= link_to user.full_name.presence || "User ##{user.id}", admin_user_path(user) %> <span class="hw-text-muted">#<%= user.id %></span></td>
            <% end %>
            <td class="hw-nowrap"><%= r.document_type ? r.document_type.humanize : "—" %><% if r.document_last4 %> · ••••<%= r.document_last4 %><% end %></td>
            <td><%= render "status_badge", request: r %></td>
            <td class="hw-nowrap hw-text-muted"><%= time_ago_in_words(r.created_at) %> ago</td>
            <td class="hw-nowrap hw-text-muted"><%= r.decided_at ? "#{l(r.decided_at, format: :short)} · #{r.decided_by&.to_s || '—'}" : "—" %></td>
            <td><%= link_to(r.requested? ? "Review →" : "Open", admin_verification_request_path(r), class: r.requested? ? "button" : "hw-link") %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
    <%= paginate @requests %>
  <% else %>
    <p class="hw-empty hw-pad" id="verification-empty"><%= @filter == "waiting" ? "No #{@kind == 'shops' ? 'shop' : 'person'} waiting. Good job." : "No #{@kind == 'shops' ? 'shop' : 'person'} requests here." %></p>
  <% end %>
</section>
