<%# VER-1 decision card. The photos load through #document with 5-minute tokens;
    each one served is written to the audit log (shown at the bottom). %>
<%
  r = @verification
  # SHOP-1: for a shop request, `user` is the APPLICANT — the owner or a
  # manager, with their own e-Tazkira (owner decision, 2026-10-08) — and the
  # shop's own facts come from the _shop_facts partial.
  shop = r.shop_subject? ? r.subject : nil
  user = shop ? r.requested_by : @user
  applicant_role = shop && (shop.shop_members.find_by(user_id: user.id)&.role || "no longer on the team")
  names_match = r.name_on_document.to_s.squish.casecmp?(user.full_name.squish)
  reports_count = user.reports_against.size
  warnings_count = user.active_warnings_count
  labels = { front: "Front", back: "Back", selfie: "Selfie with document", proof: "Proof of business" }
  subject_name = r.subject.full_name
%>
<% content_for(:title) { "Verification — #{subject_name}" } %>

<header class="hw-page-header">
  <div>
    <h1 class="hw-page-header__title main-content__page-title">
      Verification — <% if shop %><span dir="auto">🏪 <%= shop.name %></span> · applied by <% end %><%= link_to user.full_name.presence || "User ##{user.id}", admin_user_path(user), dir: "auto", id: "verify-applicant" %><% if shop %> <span class="hw-badge hw-badge--plain" id="verify-applicant-role">(<%= applicant_role.to_s.humanize %>)</span><% end %>
      <%= render "status_badge", request: r %>
    </h1>
    <p class="hw-page-header__subtitle">
      user #<%= user.id %><% if user.city.present? %> · <%= user.city %><% end %> · joined <%= user.created_at.strftime("%b %Y") %> ·
      language: <%= user.preferred_language.presence || "—" %>
    </p>
  </div>
  <div class="hw-actions">
    <%= link_to "← Queue", admin_verification_requests_path(kind: kind_of(r)), class: "button button--alt", id: "verify-back" %>
  </div>
</header>

<section class="hw-panel hw-panel--wide" id="verification-card">
  <% if shop %>
    <%= render "shop_facts", shop: shop, request: r %>
  <% else %>
  <div class="hw-verify-head">
    <% if user.avatar.attached? %>
      <%= image_tag url_for(user.avatar), class: "hw-verify-avatar", alt: "" %>
    <% end %>
    <div>
      <p class="hw-verify-line">
        <strong><%= r.document_type ? r.document_type.humanize : "Badge switched on by hand" %></strong>
        <% if @revealed_number %>
          · <code id="verify-number-revealed"><%= @revealed_number %></code>
        <% elsif r.document_last4 %>
          · ••••<%= r.document_last4 %>
          <% if r.document_number.present? %>
            <%= button_to "Show number", reveal_number_admin_verification_request_path(r), method: :post, form: { style: "display:inline" },
                  data: { turbo: false }, class: "button button--alt button--nav", id: "verify-show-number" %>
          <% end %>
        <% end %>
        · sent <%= time_ago_in_words(r.created_at) %> ago
      </p>
      <p class="hw-verify-line" dir="auto">
        Profile name: <strong><%= user.full_name %></strong> ·
        Name on document: <strong><%= r.name_on_document.presence || "—" %></strong>
        <% if r.name_on_document.present? %>
          <span class="hw-badge <%= names_match ? 'hw-badge--success' : 'hw-badge--warning' %>" id="verify-name-match"><%= names_match ? "matches ✓" : "differs" %></span>
        <% end %>
      </p>
      <p class="hw-kv">
        <span>Listings <%= user.listings.count %></span>
        <span class="<%= 'hw-text-danger' if reports_count.positive? %>">Reports <%= reports_count %></span>
        <span class="<%= 'hw-text-danger' if warnings_count.positive? %>">Warnings <%= warnings_count %></span>
        <span>Email <%= user.confirmed_at ? "confirmed" : "not confirmed" %></span>
      </p>
    </div>
  </div>
  <% end %>

  <%# Same ID number on another account (owner decision 2026-10-05). The
      applicant is never told; the admin decides. %>
  <% { "verify-same-number" => [ @same_number, "This ID is already used by" ],
       "verify-same-proof" => [ @same_proof, "This proof of business is already on" ] }.each do |dom_id, (matches, lead)| %>
    <% next if matches.blank? %>
    <div class="hw-callout hw-callout--danger" id="<%= dom_id %>">
      <% matches.map(&:subject).compact.uniq.each do |other| %>
        <% person = other.is_a?(Shop) ? other.owner : other %>
        <p class="hw-verify-line">
          ⚠ <%= lead %>
          <% if other.is_a?(Shop) %>
            shop <%= link_to "##{other.id} #{other.name}", admin_shop_path(other), dir: "auto" %> (owner <%= link_to "##{person.id}", admin_user_path(person) %>)
            <% if other.closed? || other.suspended? %><span class="hw-badge hw-badge--danger"><%= other.status %></span><% end %>
          <% else %>
            account <%= link_to "##{other.id}", admin_user_path(other) %>
          <% end %>
          <% if person.account_blocked? %><span class="hw-badge hw-badge--danger">blocked</span><% end %>
          <% if person.deleted_at %><span class="hw-badge hw-badge--plain">deleted</span><% end %>
        </p>
      <% end %>
    </div>
  <% end %>

  <% if r.files_purged_at %>
    <p class="hw-callout" id="verify-photos-purged">Photos deleted on <%= l(r.files_purged_at.to_date) %> (they are kept <%= VerificationRequest::FILES_KEPT_FOR.inspect %> after the decision). The decision and checklist stay.</p>
  <% elsif r.attached_files.any? %>
    <div class="hw-verify-photos" id="verify-photos">
      <% r.attached_files.each do |name| %>
        <% src = document_admin_verification_request_path(r, token: r.document_token(name)) %>
        <figure class="hw-verify-photo">
          <%= link_to src, target: "_blank", rel: "noopener noreferrer", title: "Open full size" do %>
            <img src="<%= src %>" alt="<%= labels[name] %>" loading="lazy" referrerpolicy="no-referrer">
          <% end %>
          <figcaption><%= labels[name] %></figcaption>
        </figure>
      <% end %>
    </div>
    <p class="hw-panel__text hw-panel__text--muted">Links expire after <%= VerificationRequest::DOCUMENT_URL_TTL.inspect %>; reload the page for fresh ones. Every photo opened is logged.</p>
  <% end %>

  <% if r.requested? %>
    <%# Owner, 2026-10-12 (item 8): Approve and Reject are two separate, clear
        actions. Reject reveals a REQUIRED reason, the "Other" text only when
        picked, and a preview of what the person gets; a missing reason comes
        back as an inline error at the field, with everything kept. The
        checklist never blocks Approve: it only counts. %>
    <% reject_error = @decision_error if @decision_error&.dig(:action) == :reject %>
    <% ticked = params[:checklist].respond_to?(:keys) ? params[:checklist].keys.map(&:to_s) : [] %>
    <%# Session token, not the per-form one: Reject posts this same form to another
        action (formaction), and a per-form token only fits the Approve URL. %>
    <%= form_with url: approve_admin_verification_request_path(r), method: :patch, data: { turbo: false }, id: "verification-decision",
                  authenticity_token: form_authenticity_token do |f| %>
      <% checks = if shop
                    { "photo_clear" => "Photos clear, nothing cropped", "name_matches" => "Name matches the owner's e-Tazkira",
                      "selfie_matches" => "Selfie = document face", "proof_valid" => "Proof shows the business is theirs",
                      "address_right" => "Pin is at the shop", "listings_clean" => "Listings are clean",
                      "no_bad_history" => "No bad history" }
                  else
                    { "photo_clear" => "Photos clear, nothing cropped", "name_matches" => "Name matches the document",
                      "selfie_matches" => "Selfie = document face", "no_bad_history" => "No bad history" }
                  end %>
      <fieldset class="hw-checks hw-verify-checks" id="verify-checklist">
        <legend>
          Checklist (saved with the decision) ·
          <span class="hw-check-count<%= ' hw-check-count--incomplete' if ticked.size < checks.size %>" id="verify-check-count"
                data-total="<%= checks.size %>"><%= ticked.size %> of <%= checks.size %> checked</span>
        </legend>
        <% checks.each do |key, label| %>
          <label class="hw-check"><%= check_box_tag "checklist[#{key}]", "1", ticked.include?(key), id: "checklist-#{key}" %> <%= label %></label>
        <% end %>
      </fieldset>

      <%# Approve and Reject both write to the owner/person through Support — say
          up front whether that message can actually be delivered. %>
      <% refusal = shop ? Conversation.admin_shop_message_refusal(shop) : Conversation.admin_message_refusal(user) %>
      <p class="hw-panel__text <%= refusal ? 'hw-text-danger' : 'hw-panel__text--muted' %>" id="verify-message-note">
        <% if refusal %>
          No Support message can reach <%= shop ? "#{shop.name}'s team" : user.full_name %>: <%= refusal %>. Decide anyway; tell them another way.
        <% else %>
          Both decisions send a Support message to <%= shop ? "#{shop.name}'s own thread" : user.full_name %>, in
          <%= user.full_name %>'s language (<%= user.preferred_language.presence || "en" %>).
        <% end %>
      </p>

      <div class="hw-decision">
        <div class="hw-decision__box" id="verify-approve-box">
          <h3 class="hw-decision__title">Approve</h3>
          <p class="hw-decision__hint">
            Gives <%= subject_name %> the Verified badge and sends a congratulations message.
            Unticked boxes don't block it.
          </p>
          <%= button_tag "Approve ✓", type: "submit", id: "verify-approve", class: "button",
                data: { confirm: "Give #{subject_name} the Verified badge?" } %>
        </div>

        <details class="hw-decision__box hw-decision__box--reject" id="verify-reject-box" <%= "open" if reject_error %>>
          <summary id="verify-reject-open">
            <h3 class="hw-decision__title">Reject…</h3>
            <p class="hw-decision__hint">Choose why: <%= user.full_name %> gets the reason in their language and can try again at once.</p>
          </summary>
          <%= render "reason_picker",
                reasons: shop ? VerificationRequest::REJECT_REASONS : VerificationRequest::REJECT_REASONS.excluding("proof_not_accepted"),
                recipient: user, prefix: "verify-reject", error: reject_error,
                selected: (params[:reason_code] if reject_error), text: (params[:reason_text] if reject_error) %>
          <%= button_tag "Reject and send the reason", type: "submit", formaction: reject_admin_verification_request_path(r),
                id: "verify-reject", class: "button button--danger",
                data: { confirm: "Reject this request? #{shop ? "The owner of #{subject_name}" : user.full_name} gets the reason in their language." } %>
        </details>
      </div>
    <% end %>
    <script>
      (function () {
        var box = document.getElementById("verify-checklist");
        var count = document.getElementById("verify-check-count");
        if (!box || !count) return;
        box.addEventListener("change", function () {
          var total = Number(count.dataset.total);
          var ticked = box.querySelectorAll("input[type=checkbox]:checked").length;
          count.textContent = ticked + " of " + total + " checked";
          count.classList.toggle("hw-check-count--incomplete", ticked < total);
        });
      })();
    </script>
  <% else %>
    <p class="hw-verify-line" id="verify-decision">
      <%= r.status.humanize %><% if r.decided_at %> on <%= l(r.decided_at, format: :short) %><% end %>
      by <%= r.decided_by&.to_s || "—" %><% if r.reason_code %> · reason: <em dir="auto"><%= r.reason_for(:en) %></em><% end %>
    </p>
    <% if r.checklist.present? %>
      <p class="hw-kv"><% r.checklist.each do |key, ticked| %><span><%= ticked ? "☑" : "☐" %> <%= key.humanize %></span><% end %></p>
    <% end %>
    <% if r.approved? && r.subject.verified? %>
      <h3 class="hw-panel__title hw-gap-top">Revoke the badge</h3>
      <%= render "reason_form", url: revoke_admin_verification_request_path(r), reasons: VerificationRequest::REVOKE_REASONS,
                 submit: "Revoke the badge", confirm: "Remove the Verified badge from #{subject_name}?",
                 recipient: user, prefix: "verify-revoke", form_id: "verify-revoke-form",
                 error: (@decision_error if @decision_error&.dig(:action) == :revoke),
                 selected: (params[:reason_code] if @decision_error&.dig(:action) == :revoke),
                 text: (params[:reason_text] if @decision_error&.dig(:action) == :revoke) %>
    <% end %>
  <% end %>
</section>

<div class="hw-panels">
  <section class="hw-panel" id="verification-history">
    <div class="hw-panel__head"><h2 class="hw-panel__title">Earlier requests (<%= @history.size %>)</h2></div>
    <% if @history.any? %>
      <table class="hw-table">
        <tbody>
          <% @history.each do |h| %>
            <tr>
              <td><%= link_to "##{h.id}", admin_verification_request_path(h) %></td>
              <td><%= render "status_badge", request: h %></td>
              <td class="hw-nowrap hw-text-muted"><%= l(h.created_at.to_date) %></td>
              <td dir="auto"><%= h.reason_code ? h.reason_for(:en) : "" %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <p class="hw-empty">First request.</p>
    <% end %>
  </section>

  <section class="hw-panel" id="verification-audit">
    <div class="hw-panel__head"><h2 class="hw-panel__title">Who did what</h2></div>
    <% if @audit.any? %>
      <table class="hw-table">
        <tbody>
          <% @audit.each do |log| %>
            <tr>
              <td class="hw-nowrap hw-text-muted"><%= l(log.created_at, format: :short) %></td>
              <td><%= log.admin_label %></td>
              <td><%= log.action.delete_prefix("verification_").humanize %></td>
              <td class="hw-text-muted" dir="auto"><%= log.details %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <p class="hw-empty">Nothing yet.</p>
    <% end %>
  </section>
</div>
