<%# Preset reasons (translated for the person by the API) + free text for "other".
    locals: url, reasons, submit, confirm; optional form_id, method (default :patch) %>
<%= form_with url: url, method: local_assigns.fetch(:method, :patch), data: { turbo: false }, id: local_assigns[:form_id], class: "hw-form-row" do |f| %>
  <%= f.select :reason_code, reasons.map { |code| [ I18n.t("verification.reasons.#{code}", locale: :en), code ] },
        { prompt: "Choose a reason…" }, class: "hw-select", required: true %>
  <%= f.text_field :reason_text, placeholder: "Only for “Other”: written to the person as typed", class: "hw-input", dir: "auto" %>
  <%= f.submit submit, class: "button button--danger", data: { confirm: confirm } %>
<% end %>
