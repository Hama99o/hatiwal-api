<% content_for(:title) { "Preview email to #{@user.full_name}" } %>

<header class="main-content__header">
  <h1 class="main-content__page-title">Preview — email to <%= link_to @user.full_name.presence || "User ##{@user.id}", admin_user_path(@user) %></h1>
</header>

<section class="main-content__body">
  <p style="margin:0 0 .75rem;font-size:.85rem;color:#64748b;">
    <strong>To:</strong> <%= @user.email %> · <strong>From / reply-to:</strong> <%= Rails.application.config.x.mail_sender %> ·
    <strong>Subject:</strong> <span dir="auto"><%= @admin_email.subject %></span>
  </p>

  <% if @rendered %>
    <%# The exact HTML the user will receive, sandboxed so nothing in it runs here. %>
    <iframe id="email-preview" title="Email preview" sandbox srcdoc="<%= @rendered %>"
            style="width:100%;height:420px;border:1px solid #e2e8f0;border-radius:10px;background:#f4f4f7;margin-bottom:1.25rem;"></iframe>
  <% end %>

  <p style="margin:0 0 .5rem;font-size:.85rem;color:#64748b;">Edit below and press Update preview, send yourself a test, or send it. Email can't be unsent.</p>
  <%= render "form", buttons: [
        [ "Update preview", preview_admin_user_emails_path(@user), { class: "button button--alt" } ],
        [ "Send a test to me", test_admin_user_emails_path(@user), { class: "button button--alt", id: "email-test" } ],
        [ "Send to #{@user.email}", admin_user_emails_path(@user),
          { class: "button", id: "email-send", name: "send", value: "1",
            data: { confirm: "Send this email to #{@user.email}? It can't be unsent." } } ]
      ] %>
</section>
