<%# A user's admin page: Administrate's header (name + Edit/Destroy) with the
    account's status badges beside the name, then one panel per job —
    message, warn, block, reports, block relationships — then every field.
    Panels go in Administrate's :before_main hook so they sit between the
    header and the fields. Styling: app/assets/stylesheets/admin.css. %>

<%
  user = page.resource
  warnings = user.warnings.recent
  active_count = user.active_warnings_count
  threshold = User::WARNING_BLOCK_THRESHOLD
  outreaches = user.admin_outreaches.includes(:admin_email, :admin_user).recent.limit(10)
  support_thread = Conversation.kind_support.find_by(buyer_id: user.id)
  reports = user.reports_against
  blocked = user.blocked_users
  blocked_by = user.blocking_users
%>

<% content_for(:header_middle) do %>
  <span class="hw-badges">
    <span class="hw-badge <%= user.account_blocked? ? 'hw-badge--danger' : 'hw-badge--success' %>"><%= user.status.to_s.humanize %></span>
    <% if user.verified? %><span class="hw-badge hw-badge--brand">Verified</span><% end %>
    <% if user.verification_requests.requested.exists? %><span class="hw-badge hw-badge--warning">Verification waiting</span><% end %>
    <% if user.seller_mode? %><span class="hw-badge hw-badge--gold">Seller</span><% end %>
    <% if active_count.positive? %><span class="hw-badge hw-badge--warning"><%= active_count %>/<%= threshold %> warnings</span><% end %>
    <% if reports.any? %><span class="hw-badge hw-badge--warning"><%= pluralize(reports.size, "report") %></span><% end %>
  </span>
<% end %>

<% content_for(:before_main) do %>
<div class="hw-panels">
  <section id="user-messages" class="hw-panel hw-panel--brand">
    <div class="hw-panel__head"><h2 class="hw-panel__title">Messages</h2></div>
    <div class="hw-actions">
      <%= link_to "Send mail", new_admin_message_path(user_id: page.resource.id, mode: "email"), class: "button", id: "message-user" %>
    <%= link_to "Send message", new_admin_message_path(user_id: page.resource.id, mode: "in_app"), class: "button", id: "message-user-in-app" %>
      <% if support_thread %>
        <%= link_to "Open support conversation", admin_support_conversation_path(support_thread), class: "button button--alt" %>
      <% end %>
    </div>
    <p class="hw-kv">
      <span>Email: <%= user.emailable? ? "available" : "not available (#{user.email_refusal_reason})" %></span>
      <span>In-app: <%= Conversation.admin_can_message?(user) ? "available" : "not available (#{Conversation.admin_message_refusal(user)})" %></span>
    </p>

    <% if outreaches.any? %>
      <div class="hw-table-wrap hw-gap-top">
        <table id="user-message-history" class="hw-table">
          <tbody>
            <% outreaches.each do |o| %>
              <tr>
                <td class="hw-nowrap hw-text-muted"><%= l(o.created_at, format: :short) %></td>
                <td class="hw-nowrap"><%= o.channels.join(" + ") %></td>
                <td dir="auto"><%= o.subject.presence || o.body.truncate(60) %></td>
                <td class="<%= 'hw-text-danger' if o.admin_email&.failed? %>">
                  <%= [ ("email #{o.admin_email.status}" if o.admin_email), ("in-app · #{o.push_note}" if o.via_in_app?) ].compact.join(" · ") %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
      <%= link_to "All messages →", admin_messages_path, class: "hw-link" %>
    <% end %>
  </section>

  <%# VER-1: the Verified badge and the requests behind it. %>
  <% ver_status = VerificationStatus.new(user) %>
  <% ver_requests = user.verification_requests.where.not(status: :cancelled).recent.limit(5) %>
  <section id="user-verification" class="hw-panel">
    <div class="hw-panel__head"><h2 class="hw-panel__title">Verification — <%= ver_status.state.humanize %></h2></div>
    <% if ver_requests.any? %>
      <ul class="hw-list">
        <% ver_requests.each do |vr| %>
          <li><%= link_to "##{vr.id}", admin_verification_request_path(vr) %> <%= render "admin/verification_requests/status_badge", request: vr %>
            <span class="hw-text-muted"><%= l(vr.created_at.to_date) %><%= " · #{vr.reason_for(:en)}" if vr.reason_code %></span></li>
        <% end %>
      </ul>
    <% else %>
      <p class="hw-empty">Never applied<%= " (missing: #{user.verification_missing.join(', ')})" if user.verification_missing.any? && !user.verified? %>.</p>
    <% end %>
    <% if user.verified? && !user.support_account? %>
      <p class="hw-panel__text hw-panel__text--muted">Remove the badge, with a reason sent to them in their language.</p>
      <%= render "admin/verification_requests/reason_form", url: revoke_badge_admin_verification_requests_path(user_id: user.id),
                 reasons: VerificationRequest::REVOKE_REASONS, submit: "Revoke badge", form_id: "revoke-badge",
                 confirm: "Remove the Verified badge from #{user.full_name}?", method: :post %>
    <% end %>
  </section>

  <section class="hw-panel hw-panel--warning">
    <div class="hw-panel__head">
      <h2 class="hw-panel__title">Warnings — <%= active_count %> of <%= threshold %> active</h2>
    </div>
    <p class="hw-panel__text hw-panel__text--muted">
      Each warning is active for <%= UserWarning::ACTIVE_PERIOD.inspect %> then decays.
      Reaching <%= threshold %> active warnings auto-suspends the user (lifts automatically as warnings expire).
    </p>

    <% unless user.account_blocked? %>
      <%= form_with url: warn_admin_user_path(user), method: :post, data: { turbo: false }, class: "hw-form-row" do |f| %>
        <%= f.select :category, UserWarning.categories.keys.map { |c| [ c.humanize, c ] }, {}, class: "hw-select" %>
        <%= f.text_field :reason, placeholder: "Reason (shown to the user)", class: "hw-input", dir: "auto" %>
        <%= f.submit "Issue warning", class: "button",
              data: { confirm: "Issue a warning to #{user.full_name}?" } %>
      <% end %>
    <% end %>

    <% if warnings.any? %>
      <div class="hw-table-wrap">
        <table class="hw-table">
          <thead><tr><th>Category</th><th>Reason</th><th>Issued</th><th>Status</th></tr></thead>
          <tbody>
            <% warnings.each do |w| %>
              <tr>
                <td class="hw-nowrap"><%= w.category.to_s.humanize %></td>
                <td dir="auto"><%= w.reason %></td>
                <td class="hw-nowrap"><%= w.created_at.strftime("%Y-%m-%d") %></td>
                <td>
                  <% if w.active? %>
                    <span class="hw-badge hw-badge--warning">active → expires <%= w.expires_at.strftime("%Y-%m-%d") %></span>
                  <% else %>
                    <span class="hw-badge hw-badge--plain">expired</span>
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <p class="hw-empty">No warnings yet.</p>
    <% end %>
  </section>

  <%# LOC-1 — own address vs guessed location (hatiwal-mobile/docs/USER_LOCATION.md).
      The guess is admin-only: never in a public serializer. %>
  <% effective = user.effective_location %>
  <section id="user-location" class="hw-panel">
    <div class="hw-panel__head"><h2 class="hw-panel__title">Location — own vs guessed</h2></div>
    <p class="hw-panel__text hw-panel__text--muted">
      The Bazaar uses own address → guessed → Kabul. Now using:
      <span class="hw-badge hw-badge--plain"><%= effective[:source] %></span>
      <%= effective[:province] || "—" %> (<%= effective[:latitude] %>, <%= effective[:longitude] %>)
    </p>
    <div class="hw-split">
      <div>
        <strong>Own address (set by the user)</strong>
        <% if user.province.present? || user.city.present? || user.latitude.present? %>
          <ul class="hw-list">
            <li dir="auto">Province: <%= user.province.presence || "—" %> · City: <%= user.city.presence || "—" %></li>
            <li>Point: <%= user.latitude.present? ? "#{user.latitude}, #{user.longitude}" : "—" %></li>
            <% unless user.own_location? %><li>Outside the service area — not used</li><% end %>
          </ul>
        <% else %>
          <p class="hw-empty">None</p>
        <% end %>
      </div>
      <div>
        <strong>Guessed (learned by the app)</strong>
        <% if user.guessed_latitude.present? %>
          <ul class="hw-list">
            <li dir="auto">Province: <%= user.guessed_province.presence || "—" %></li>
            <li>Point: <%= user.guessed_latitude %>, <%= user.guessed_longitude %></li>
            <li>From: <%= user.guessed_source.to_s.humanize %> · <%= user.guessed_at && l(user.guessed_at, format: :short) %></li>
          </ul>
        <% else %>
          <p class="hw-empty">None</p>
        <% end %>
      </div>
    </div>
  </section>

  <section class="hw-panel">
    <div class="hw-panel__head"><h2 class="hw-panel__title">Reports against this user (<%= reports.size %>)</h2></div>
    <% if reports.any? %>
      <div class="hw-table-wrap">
        <table class="hw-table">
          <thead><tr><th>Report</th><th>What</th><th>Reason</th><th>Status</th></tr></thead>
          <tbody>
            <% reports.each do |r| %>
              <tr>
                <td><%= link_to "##{r.id}", [ namespace, r ] %></td>
                <td dir="auto">
                  <% if r.reportable.is_a?(Listing) %>
                    Listing: <%= link_to(r.reportable.title.presence || "##{r.reportable_id}", [ namespace, r.reportable ]) %>
                  <% else %>
                    This user
                  <% end %>
                </td>
                <td><%= r.reason.to_s.humanize %></td>
                <td><span class="hw-badge <%= r.status.to_s == 'pending' ? 'hw-badge--warning' : 'hw-badge--plain' %>"><%= r.status %></span></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <p class="hw-empty">No reports against this user.</p>
    <% end %>
  </section>

  <section class="hw-panel">
    <div class="hw-panel__head"><h2 class="hw-panel__title">Block relationships</h2></div>
    <p class="hw-panel__text hw-panel__text--muted">
      User-to-user blocks (a privacy tool between members — separate from an admin ban).
    </p>
    <div class="hw-split">
      <div>
        <strong>Has blocked (<%= blocked.size %>)</strong>
        <% if blocked.any? %>
          <ul class="hw-list">
            <% blocked.each do |u| %>
              <li dir="auto"><%= link_to(u.full_name.presence || "User ##{u.id}", [ namespace, u ]) %></li>
            <% end %>
          </ul>
        <% else %>
          <p class="hw-empty">None</p>
        <% end %>
      </div>
      <div>
        <strong>Blocked by (<%= blocked_by.size %>)</strong>
        <% if blocked_by.any? %>
          <ul class="hw-list">
            <% blocked_by.each do |u| %>
              <li dir="auto"><%= link_to(u.full_name.presence || "User ##{u.id}", [ namespace, u ]) %></li>
            <% end %>
          </ul>
        <% else %>
          <p class="hw-empty">None</p>
        <% end %>
      </div>
    </div>
  </section>

  <section class="hw-panel hw-panel--danger hw-panel--wide">
    <div class="hw-panel__head"><h2 class="hw-panel__title">Account moderation</h2></div>
    <% if user.account_blocked? %>
      <div class="hw-callout hw-callout--danger">
        This account is <strong><%= user.status.upcase %></strong> — the user
        cannot log in and is told they are blocked.
        <% if user.block_reason.present? %>
          <br>Reason given: <em dir="auto"><%= user.block_reason %></em>
        <% end %>
      </div>
      <%= button_to "Unblock user", unblock_admin_user_path(user),
            method: :patch, data: { turbo: false }, class: "button" %>
    <% else %>
      <p class="hw-panel__text">
        Blocking bans this user from the whole app immediately (use for severe cases —
        warnings are the gradual path). They’ll see the reason you enter below.
      </p>
      <%= form_with url: block_admin_user_path(user), method: :patch, data: { turbo: false }, class: "hw-form-row" do |f| %>
        <%= f.text_field :block_reason, placeholder: "Reason shown to the user (optional)", class: "hw-input", dir: "auto" %>
        <%= f.submit "Block user", class: "button button--danger",
              data: { confirm: "Block #{user.full_name}? They will be signed out and told they are blocked." } %>
      <% end %>
    <% end %>
  </section>
</div>
<h2 class="hw-section__title hw-record-title">All fields</h2>
<% end %>

<%= render template: "administrate/application/show", locals: { page: page } %>
