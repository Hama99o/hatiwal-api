<% content_for(:title) { "Preview message" } %>

<header class="main-content__header">
  <h1 class="main-content__page-title">Preview</h1>
</header>

<section class="main-content__body">
  <%= render "recipient" %>

  <% if @sender.email? && @rendered %>
    <h2 style="font-size:.9rem;color:#334155;margin:0 0 .4rem;">Email — <span dir="auto"><%= params[:subject] %></span></h2>
    <%# The exact HTML the user will receive, escaped into srcdoc and sandboxed. %>
    <iframe id="email-preview" title="Email preview" sandbox srcdoc="<%= @rendered %>"
            style="width:100%;height:360px;border:1px solid #e2e8f0;border-radius:10px;background:#f4f4f7;margin-bottom:1.1rem;"></iframe>
  <% end %>

  <% if @sender.in_app? %>
    <h2 style="font-size:.9rem;color:#334155;margin:0 0 .4rem;">In the app, from Hatiwal Support</h2>
    <div id="in-app-preview" dir="auto" style="max-width:420px;padding:.6rem .8rem;border-radius:12px;background:#eef2ff;border:1px solid #c7d2fe;white-space:pre-wrap;margin-bottom:.4rem;"><%= params[:body] %></div>
    <p style="margin:0 0 1.1rem;font-size:.8rem;color:#64748b;">Push: <%= @sender.push_note %></p>
  <% end %>

  <% channels = [ ("email" if @sender.email?), ("in the app" if @sender.in_app?) ].compact.join(" and ") %>
  <%= render "compose_form", buttons: [
        [ "Update preview", preview_admin_messages_path, { class: "button button--alt" } ],
        [ "Send a test email to me", test_admin_messages_path, { class: "button button--alt", id: "message-test", disabled: !@sender.email? } ],
        [ "Send", admin_messages_path,
          { class: "button", id: "message-send", name: "send", value: "1",
            data: { confirm: "Send to #{@user.full_name} by #{channels}? It can't be unsent." } } ]
      ] %>
</section>
