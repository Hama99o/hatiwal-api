<% content_for(:title) { "Preview message" } %>

<header class="ad-page-header">
  <div>
    <h1 class="ad-page-header__title main-content__page-title">Preview</h1>
    <p class="ad-page-header__subtitle">Exactly what they'll get. Nothing has been sent yet.</p>
  </div>
</header>

<section class="ad-card">
  <%= render "recipient" %>

  <% if @sender.email? && @rendered %>
    <h2 class="ad-preview-label">Email — <span dir="auto"><%= params[:subject] %></span></h2>
    <%# The exact HTML the user will receive, escaped into srcdoc and sandboxed. %>
    <iframe id="email-preview" title="Email preview" sandbox srcdoc="<%= @rendered %>"
            class="ad-preview-frame"></iframe>
  <% end %>

  <% if @sender.in_app? %>
    <h2 class="ad-preview-label">In the app, from Hatiwal Support</h2>
    <div id="in-app-preview" dir="auto" class="ad-bubble ad-bubble--preview ad-bubble__body"><%= params[:body] %></div>
    <p class="ad-note ad-step">Push: <%= @sender.push_note %></p>
  <% end %>

  <% channels = [ ("email" if @sender.email?), ("in the app" if @sender.in_app?) ].compact.join(" and ") %>
  <%= render "compose_form", buttons: [
        [ "Update preview", preview_admin_messages_path, { class: "button button--alt" } ],
        [ "Send a test email to me", test_admin_messages_path, { class: "button button--alt", id: "message-test", disabled: !@sender.email? } ],
        [ "Send", admin_messages_path,
          { class: "button", id: "message-send", name: "send", value: "1",
            data: { confirm: "Send to #{@user.full_name} by #{channels}? It can't be unsent." } } ]
      ] %>
</section>
