<% content_for(:title) { "Messages" } %>

<header class="hw-page-header">
  <div>
    <h1 class="hw-page-header__title main-content__page-title">Messages</h1>
    <p class="hw-page-header__subtitle">
      Everything sent — to one person by email, in the app as Hatiwal Support, or both (including replies from
      the Support inbox), and bulk emails to a segment. Email is sent from <%= Rails.application.config.x.mail_sender %>.
      Latest <%= Admin::MessagesController::HISTORY_LIMIT %>.
    </p>
  </div>
  <div class="hw-actions">
    <%# The four ways to reach people. Single sends are one box; bulk sends
        have the four-language versions; messages never have a subject. %>
    <%= link_to "Send mail", new_admin_message_path(mode: "email"), class: "button", id: "send-mail" %>
    <%= link_to "Send message", new_admin_message_path(mode: "in_app"), class: "button", id: "send-message" %>
    <%= link_to "Send bulk mail", new_admin_bulk_email_path(mode: "email"), class: "button button--alt", id: "send-bulk-mail" %>
    <%= link_to "Send bulk message", new_admin_bulk_email_path(mode: "in_app"), class: "button button--alt", id: "send-bulk-message" %>
  </div>
</header>

<section class="main-content__body main-content__body--flush">

  <% if @entries.any? %>
    <table id="message-history">
      <thead>
        <tr>
          <th>When</th><th>To</th>
          <th>By</th><th>Message</th>
          <th>What happened</th><th>Admin</th>
        </tr>
      </thead>
      <tbody>
        <% @entries.each do |o| %>
          <% if o.is_a?(AdminBulkEmail) %>
            <%# group(:status).count keys by the enum NAME ("sent"), not its integer. %>
            <% n = ->(st) { @bulk_counts[[ o.id, st.to_s ]].to_i } %>
            <tr class="bulk-row">
              <td class="hw-nowrap hw-text-muted"><%= l(o.created_at, format: :short) %></td>
              <td><%= link_to pluralize(o.recipients_count, "person", plural: "people"), admin_bulk_email_path(o) %><span class="hw-sub"><%= o.segment %></span></td>
              <td><span class="hw-badge hw-badge--brand hw-badge--plain">Bulk <%= o.channels.join(" + ").downcase %></span><span class="hw-sub"><%= o.filled_locales.join(" · ") %></span></td>
              <td dir="auto">
                <%= link_to admin_bulk_email_path(o), class: "hw-link" do %>
                  <% if (subj = o.content.dig(o.fallback_locale, "subject")).present? %><strong><%= subj %></strong><br><% end %>
                  <%= o.content.dig(o.fallback_locale, "body").to_s.truncate(120) %>
                <% end %>
                <span class="hw-sub"><%= link_to "View every language →", admin_bulk_email_path(o, anchor: "bulk-sent"), class: "bulk-view" %></span>
              </td>
              <% ia = ->(st) { @bulk_in_app_counts[[ o.id, st.to_s ]].to_i } %>
              <td><%= o.status.humanize %>:
                <% if o.via_email? %>email <%= n.(:sent) %> sent · <%= n.(:failed) %> failed · <%= n.(:queued) + n.(:sending) %> waiting<%= " · #{n.(:cancelled)} cancelled" if n.(:cancelled).positive? %><% end %>
                <% if o.via_in_app? %><%= " · " if o.via_email? %>in-app <%= ia.(:sent) %> delivered · <%= ia.(:skipped) %> refused<%= " · #{ia.(:failed)} failed" if ia.(:failed).positive? %><% end %>
              </td>
              <td class="hw-text-muted"><%= o.admin_user&.email %></td>
            </tr>
            <% next %>
          <% end %>
          <tr>
            <td class="hw-nowrap hw-text-muted"><%= l(o.created_at, format: :short) %></td>
            <td dir="auto"><%= link_to o.user.full_name.presence || "User ##{o.user_id}", admin_user_path(o.user) %></td>
            <td><%= o.channels.join(" + ") %><%= " (support inbox)" if o.support_inbox? %>
              <span class="hw-sub outreach-language"><%= Admin::LanguageVersions::NAMES[o.locale] || o.locale.presence || "—" %></span></td>
            <td dir="auto">
              <%= link_to admin_message_path(o), class: "hw-link" do %>
                <% if o.subject.present? %><strong><%= o.subject %></strong><br><% end %>
                <%= o.body.truncate(140) %>
              <% end %>
              <span class="hw-sub"><%= link_to "View →", admin_message_path(o), class: "outreach-view" %></span>
            </td>
            <td>
              <% if (e = o.admin_email) %>
                <div class="<%= 'hw-text-danger' if e.failed? %>">Email: <%= e.status %><%= ": #{e.error}" if e.failed? && e.error.present? %></div>
              <% end %>
              <% if o.via_in_app? %>
                <div>In-app: in their inbox · <%= o.push_note %></div>
              <% end %>
              <% if o.opt_out_acknowledged? %><div class="hw-sub">sent despite bulk opt-out (acknowledged)</div><% end %>
            </td>
            <td class="hw-text-muted"><%= o.admin_user&.email %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <p class="hw-empty hw-pad">Nothing sent yet.</p>
  <% end %>
</section>
