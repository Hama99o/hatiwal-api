<% content_for(:title) { "New message" } %>

<header class="ad-page-header">
  <div>
    <h1 class="ad-page-header__title main-content__page-title">New message</h1>
    <p class="ad-page-header__subtitle">To one person, by email, in the app as Hatiwal Support, or both.</p>
  </div>
  <%= link_to "← Messages", admin_messages_path, class: "button button--alt" %>
</header>

<section class="ad-card">
  <% if @user %>
    <%= render "recipient" %>
    <p class="ad-note ad-step">Nothing is sent from this page — you'll see a preview first.</p>
    <%= render "compose_form", buttons: [ [ "Preview", preview_admin_messages_path, { class: "button" } ] ] %>
  <% else %>
    <%= form_with url: new_admin_message_path, method: :get, id: "recipient-search", data: { turbo: false } do %>
      <label class="ad-label" for="q">Who is this for?</label>
      <div class="ad-search">
        <%= search_field_tag :q, params[:q], placeholder: "Name, email or phone", autofocus: true, dir: "auto", class: "ad-input" %>
        <button class="button" type="submit">Find</button>
      </div>
    <% end %>

    <% if @results %>
      <% if @results.any? %>
        <ul id="recipient-results" class="ad-results">
          <% @results.each do |u| %>
            <li>
              <%= link_to u.full_name.presence || "User ##{u.id}", new_admin_message_path(user_id: u.id), dir: "auto" %>
              <span class="ad-text-muted"> · <%= u.email %><%= " · #{u.phone}" if u.phone.present? %> · <%= u.city %></span>
            </li>
          <% end %>
        </ul>
      <% else %>
        <p class="ad-empty ad-gap-top">No one matches “<%= params[:q] %>”.</p>
      <% end %>
    <% end %>
  <% end %>
</section>
