<%# One form for every step; the draft travels with each. `buttons`: [label, path, html options]. %>
<% sender = @sender %>
<% chosen = Array(params[:channels]) %>
<% if sender && sender.errors.any? %>
  <div id="message-errors" class="ad-callout ad-callout--danger">
    <%= sender.errors.to_sentence %>
  </div>
<% end %>

<%# Session token, not the per-form one: these buttons post to other actions via formaction. %>
<%= form_with url: preview_admin_messages_path, method: :post, data: { turbo: false }, id: "message-form",
      authenticity_token: form_authenticity_token do |f| %>
  <%= hidden_field_tag :user_id, @user.id %>

  <fieldset class="ad-checks">
    <legend>Send by</legend>
    <% [ [ "email", "Email", @email_refusal ], [ "in_app", "In-app message from Hatiwal Support", @in_app_refusal ] ].each do |value, label, refusal| %>
      <label class="channel" data-channel="<%= value %>">
        <%= check_box_tag "channels[]", value, chosen.include?(value) && refusal.nil?, disabled: refusal.present?, id: "channel-#{value}" %>
        <span><%= label %><% if refusal %> <em class="ad-check__why">— not available: <%= refusal %></em><% end %></span>
      </label>
    <% end %>
  </fieldset>

  <div class="ad-field">
    <label class="ad-label" for="subject">Subject <span class="ad-label__hint">(email only)</span></label>
    <%= text_field_tag :subject, params[:subject], maxlength: AdminEmail::SUBJECT_MAX, dir: "auto", class: "ad-input" %>
  </div>

  <div class="ad-field">
    <label class="ad-label" for="body">Message</label>
    <%= text_area_tag :body, params[:body], rows: 9, required: true, maxlength: AdminEmail::BODY_MAX, dir: "auto", class: "ad-textarea",
          placeholder: "Plain text, in the user's language — Pashto, Dari and Urdu display right-to-left. The same text goes to every channel you tick." %>
  </div>

  <% if @user.email_opt_out_at.present? %>
    <label class="ad-check ad-check--warning">
      <%= check_box_tag :opt_out_acknowledged, "1", params[:opt_out_acknowledged] == "1" %>
      This email is about their account, not an announcement (they unsubscribed from bulk email).
    </label>
  <% end %>

  <div class="ad-actions ad-gap-top">
    <% buttons.each do |label, path, extra| %>
      <%= f.button label, formaction: path, **(extra || {}) %>
    <% end %>
    <%= link_to "Cancel", admin_messages_path, class: "ad-link" %>
  </div>
<% end %>
