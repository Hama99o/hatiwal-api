<%# One form for every step; the draft travels with each. `buttons`: [label, path, html options]. %>
<% sender = @sender %>
<% chosen = Array(params[:channels]) %>
<% if sender && sender.errors.any? %>
  <div id="message-errors" class="hw-callout hw-callout--danger">
    <%= sender.errors.to_sentence %>
  </div>
<% end %>

<%# Session token, not the per-form one: these buttons post to other actions via formaction. %>
<%= form_with url: preview_admin_messages_path, method: :post, data: { turbo: false }, id: "message-form",
      authenticity_token: form_authenticity_token do |f| %>
  <%= hidden_field_tag :user_id, @user.id %>

  <% if @mode %>
    <%# A fixed channel (Send mail / Send message): no choice to make here. %>
    <%= hidden_field_tag :mode, @mode %>
    <% refusal = @mode == "email" ? @email_refusal : @in_app_refusal %>
    <% if refusal %>
      <p class="hw-callout hw-callout--danger" id="mode-refusal">Can't send <%= @mode == "email" ? "an email" : "a message" %> to this user: <%= refusal %>.</p>
    <% end %>
  <% else %>
    <fieldset class="hw-checks">
      <legend>Send by</legend>
      <% [ [ "email", "Email", @email_refusal ], [ "in_app", "In-app message from Hatiwal Support", @in_app_refusal ] ].each do |value, label, refusal| %>
        <label class="channel" data-channel="<%= value %>">
          <%= check_box_tag "channels[]", value, chosen.include?(value) && refusal.nil?, disabled: refusal.present?, id: "channel-#{value}" %>
          <span><%= label %><% if refusal %> <em class="hw-check__why">— not available: <%= refusal %></em><% end %></span>
        </label>
      <% end %>
    </fieldset>
  <% end %>

  <%# ONE box for one known person, written in their language. No fallback:
      with a single recipient there is nobody else to fall back for. (Bulk has
      the four-language system — bulk_emails/_language_versions.) %>
  <% names = Admin::LanguageVersions::NAMES %>
  <% reader = @user.preferred_language.presence_in(Admin::LanguageVersions::LOCALES) %>
  <% rtl = %w[ps fa ur].include?(reader) %>
  <p class="reader-mark hw-lang__reader">
    <% if reader %>
      <%= @user.firstname.presence || "This user" %> reads <%= names[reader] %>: write in <%= names[reader] %> — this box is what they get.
    <% else %>
      <%= @user.firstname.presence || "This user" %> has no language set.
    <% end %>
  </p>

  <% unless @mode == "in_app" %>
  <div class="hw-field lang-subject">
    <label class="hw-label" for="subject">Subject <span class="hw-label__hint">(email)</span></label>
    <%= text_field_tag :subject, params[:subject], maxlength: AdminEmail::SUBJECT_MAX, dir: (rtl ? "rtl" : "auto"), class: "hw-input" %>
  </div>
  <% end %>

  <div class="hw-field">
    <label class="hw-label" for="body">Message</label>
    <%= text_area_tag :body, params[:body], rows: 9, required: true, maxlength: AdminEmail::BODY_MAX,
          dir: (rtl ? "rtl" : "auto"), class: "hw-textarea" %>
  </div>

  <% if @user.email_opt_out_at.present? && @mode != "in_app" %>
    <label class="hw-check hw-check--warning">
      <%= check_box_tag :opt_out_acknowledged, "1", params[:opt_out_acknowledged] == "1" %>
      This email is about their account, not an announcement (they unsubscribed from bulk email).
    </label>
  <% end %>

  <div class="hw-actions hw-gap-top">
    <% buttons.each do |label, path, extra| %>
      <%= f.button label, formaction: path, **(extra || {}) %>
    <% end %>
    <%= link_to "Cancel", admin_messages_path, class: "hw-link" %>
  </div>
<% end %>

<%# Subject belongs to email only: shown while Email is ticked, hidden otherwise. %>
<script>
  (function () {
    var email = document.getElementById("channel-email");
    var subject = document.querySelector("#message-form .lang-subject");
    if (!subject || !email) return; // a fixed mode: the subject is decided server-side
    function sync() { subject.style.display = email.checked ? "" : "none"; }
    email.addEventListener("change", sync);
    sync();
  })();
</script>
