<% content_for(:title) { "Preview bulk message" } %>
<% by_lang = @audience.reached_by_language(email: @bulk.via_email?, in_app: @bulk.via_in_app?) %>
<% names = AdminBulkEmail::LANGUAGE_NAMES %>
<%# People reached across the chosen channels, each counted once. %>
<% count = @audience.reached(email: @bulk.via_email?, in_app: @bulk.via_in_app?).size %>
<% in_app_n = @bulk.via_in_app? ? @audience.in_app_recipients_count : 0 %>
<% fallback_note = (AdminBulkEmail::LOCALES - @bulk.filled_locales).select { |l| by_lang[l].positive? }
                     .map { |l| "#{by_lang[l]} #{names[l]}" } %>
<% fallback_note << "#{by_lang['other']} with no language set" if by_lang["other"].positive? %>

<header class="hw-page-header">
  <div>
    <h1 class="hw-page-header__title main-content__page-title">Preview — <%= bulk_title.downcase %> (<%= @bulk.channels.join(" + ") %>)</h1>
    <p class="hw-page-header__subtitle">Exactly what each language group gets. Nothing has been sent yet.</p>
  </div>
</header>

<section>
  <%= render "audience" %>

  <% if fallback_note.any? %>
    <p id="fallback-summary" class="hw-callout hw-callout--warning">
      <%= fallback_note.to_sentence %> recipient(s) will receive the <strong><%= names[@bulk.fallback_locale] %></strong> version.
    </p>
  <% end %>

  <% (@rendered || {}).compact.each do |loc, html| %>
    <h2 class="hw-preview-label">
      <%= names[loc] %> — <%= @bulk.locale_for(loc) == loc ? by_lang[loc] : 0 %> own<%= " + fallback recipients" if loc == @bulk.fallback_locale %>
      · <span dir="auto"><%= @bulk.content.dig(loc, "subject") %></span>
    </h2>
    <iframe class="bulk-preview" data-locale="<%= loc %>" title="<%= names[loc] %> preview" sandbox srcdoc="<%= html %>"
            class="hw-preview-frame hw-preview-frame--short"></iframe>
  <% end %>

  <% if @bulk.via_in_app? %>
    <% @bulk.filled_locales.each do |loc| %>
      <h2 class="hw-preview-label">In the app, from Hatiwal Support — <%= names[loc] %></h2>
      <div class="in-app-bulk-preview hw-bubble hw-bubble--preview hw-bubble__body" data-locale="<%= loc %>"
           dir="<%= %w[ps fa ur].include?(loc) ? "rtl" : "ltr" %>"><%= @bulk.content.dig(loc, "body") %></div>
    <% end %>
    <p class="hw-note hw-step" id="in-app-push-choice">
      Push: sent to everyone who can receive one — <%= @audience.in_app_push_reachable_count %> of <%= in_app_n %>.
    </p>
  <% end %>

  <%= render "compose", buttons: [
        [ "Update preview", preview_admin_bulk_emails_path, { class: "button button--alt" } ],
        [ "Send a test of each language to me", test_admin_bulk_emails_path, { class: "button button--alt", id: "bulk-test", disabled: !@bulk.via_email? } ]
      ] %>

  <%# Sending: type the number. "Send to 38 people" is a different decision from "send to 3". %>
  <%= form_with url: admin_bulk_emails_path, method: :post, data: { turbo: false }, id: "bulk-send-form",
        authenticity_token: form_authenticity_token, class: "hw-confirm" do |f| %>
    <% admin_filter_values.compact.each do |k, v| %><%= hidden_field_tag k, v %><% end %>
    <%= hidden_field_tag :fallback_locale, @bulk.fallback_locale %>
    <% if @mode %><%= hidden_field_tag :mode, @mode, id: nil %><% end %>
    <% @bulk.channels.each do |c| %><%= hidden_field_tag "channels[]", c == "Email" ? "email" : "in_app", id: nil %><% end %>
    <% AdminBulkEmail::LOCALES.each do |loc| %>
      <%= hidden_field_tag "content[#{loc}][subject]", @raw_content.dig(loc, "subject") %>
      <%= hidden_field_tag "content[#{loc}][body]", @raw_content.dig(loc, "body") %>
    <% end %>
    <label for="confirm-count" id="confirm-text">
      This goes to <%= count %> <%= count == 1 ? "person" : "people" %> and can't be unsent.
      <% if @bulk.via_in_app? %>
        It posts into <%= in_app_n == 1 ? "1 user's Support conversation" : "#{in_app_n} users' Support conversations" %>. They can't unsubscribe from it — only archive Support.
      <% end %>
      Type <%= count %> to send.
    </label>
    <div class="hw-form-row">
      <%= number_field_tag :confirm_count, nil, id: "confirm-count", min: 0, autocomplete: "off", class: "hw-input" %>
      <%= f.submit "Send to #{count} people", id: "bulk-send", class: "button button--danger", disabled: true, data: { expected: count } %>
    </div>
  <% end %>
  <script>
    (function () {
      var input = document.getElementById("confirm-count"), btn = document.getElementById("bulk-send");
      input.addEventListener("input", function () { btn.disabled = input.value !== btn.dataset.expected; });
    })();
  </script>
</section>
