<% content_for(:title) { "Preview bulk email" } %>
<% by_lang = @audience.by_language %>
<% names = AdminBulkEmail::LANGUAGE_NAMES %>
<% count = @audience.recipients_count %>
<% fallback_note = (AdminBulkEmail::LOCALES - @bulk.filled_locales).select { |l| by_lang[l].positive? }
                     .map { |l| "#{by_lang[l]} #{names[l]}" } %>
<% fallback_note << "#{by_lang['other']} with no language set" if by_lang["other"].positive? %>

<header class="ad-page-header">
  <div>
    <h1 class="ad-page-header__title main-content__page-title">Preview — bulk email</h1>
    <p class="ad-page-header__subtitle">Exactly what each language group gets. Nothing has been sent yet.</p>
  </div>
</header>

<section>
  <%= render "audience" %>

  <% if fallback_note.any? %>
    <p id="fallback-summary" class="ad-callout ad-callout--warning">
      <%= fallback_note.to_sentence %> recipient(s) will receive the <strong><%= names[@bulk.fallback_locale] %></strong> version.
    </p>
  <% end %>

  <% (@rendered || {}).each do |loc, html| %>
    <h2 class="ad-preview-label">
      <%= names[loc] %> — <%= @bulk.locale_for(loc) == loc ? by_lang[loc] : 0 %> own<%= " + fallback recipients" if loc == @bulk.fallback_locale %>
      · <span dir="auto"><%= @bulk.content.dig(loc, "subject") %></span>
    </h2>
    <iframe class="bulk-preview" data-locale="<%= loc %>" title="<%= names[loc] %> preview" sandbox srcdoc="<%= html %>"
            class="ad-preview-frame ad-preview-frame--short"></iframe>
  <% end %>

  <%= render "compose", buttons: [
        [ "Update preview", preview_admin_bulk_emails_path, { class: "button button--alt" } ],
        [ "Send a test of each language to me", test_admin_bulk_emails_path, { class: "button button--alt", id: "bulk-test" } ]
      ] %>

  <%# Sending: type the number. "Send to 38 people" is a different decision from "send to 3". %>
  <%= form_with url: admin_bulk_emails_path, method: :post, data: { turbo: false }, id: "bulk-send-form",
        authenticity_token: form_authenticity_token, class: "ad-confirm" do |f| %>
    <% admin_filter_values.compact.each do |k, v| %><%= hidden_field_tag k, v %><% end %>
    <%= hidden_field_tag :fallback_locale, @bulk.fallback_locale %>
    <% AdminBulkEmail::LOCALES.each do |loc| %>
      <%= hidden_field_tag "content[#{loc}][subject]", @raw_content.dig(loc, "subject") %>
      <%= hidden_field_tag "content[#{loc}][body]", @raw_content.dig(loc, "body") %>
    <% end %>
    <label for="confirm-count">
      This goes to <%= count %> people and can't be unsent. Type <%= count %> to send.
    </label>
    <div class="ad-form-row">
      <%= number_field_tag :confirm_count, nil, id: "confirm-count", min: 0, autocomplete: "off", class: "ad-input" %>
      <%= f.submit "Send to #{count} people", id: "bulk-send", class: "button button--danger", disabled: true, data: { expected: count } %>
    </div>
  <% end %>
  <script>
    (function () {
      var input = document.getElementById("confirm-count"), btn = document.getElementById("bulk-send");
      input.addEventListener("input", function () { btn.disabled = input.value !== btn.dataset.expected; });
    })();
  </script>
</section>
