<% content_for(:title) { "Bulk message ##{@bulk.id}" } %>
<% c = @counts %>
<% names = AdminBulkEmail::LANGUAGE_NAMES %>

<header class="hw-page-header">
  <div>
    <h1 class="hw-page-header__title main-content__page-title">Bulk message (<%= @bulk.channels.join(" + ") %>) — <span dir="auto"><%= @bulk.content.dig(@bulk.fallback_locale, "subject").presence || @bulk.content.dig(@bulk.fallback_locale, "body").to_s.truncate(60) %></span></h1>
    <p class="hw-page-header__subtitle">
      Segment: <%= @bulk.segment %> · languages written: <%= @bulk.filled_locales.map { |l| names[l] }.join(", ") %>
      (fallback <%= names[@bulk.fallback_locale] %>) · by <%= @bulk.admin_user.email %> · <%= l(@bulk.created_at, format: :short) %>
    </p>
  </div>
  <div class="hw-actions">
    <%= link_to "← Messages", admin_messages_path, class: "button button--alt" %>
    <% if @bulk.sending? %>
      <%= button_to "Stop", stop_admin_bulk_email_path(@bulk), method: :patch, data: { turbo: false, confirm: "Stop? Anyone not yet sent to won't get it." }, class: "button button--danger", id: "bulk-stop" %>
    <% end %>
    <% if (@bulk.paused_daily_limit? || @bulk.sending?) && @bulk.remaining? %>
      <%= button_to "Resume", resume_admin_bulk_email_path(@bulk), method: :patch, data: { turbo: false }, class: "button button--alt", id: "bulk-resume" %>
    <% end %>
  </div>
</header>

<% ia = @in_app_counts %>
<p id="bulk-status" class="hw-callout">
    <span class="hw-badge hw-badge--brand"><%= @bulk.status.humanize %></span>
    <% if @bulk.via_email? %>
      Email: <%= c["sent"].to_i %> sent · <%= c["failed"].to_i %> failed · <%= c["queued"].to_i + c["sending"].to_i %> waiting ·
      <%= c["cancelled"].to_i %> cancelled.
    <% end %>
    <% if @bulk.via_in_app? %>
      <span id="bulk-in-app-status">In-app: <%= ia["sent"].to_i %> delivered · <%= ia["skipped"].to_i %> refused by the gate ·
      <%= ia["failed"].to_i %> failed · <%= ia["queued"].to_i + ia["sending"].to_i %> waiting · <%= ia["cancelled"].to_i %> cancelled.</span>
      Push <%= @bulk.push? ? "on (everyone who can receive one)" : "off" %>.
    <% end %>
    — <%= pluralize(@bulk.recipients_count, "person", plural: "people") %>
</p>
<% if @bulk.paused_daily_limit? %>
    <p class="hw-callout hw-callout--warning">
      Paused at the daily limit (<%= Admin::MailQuota::DAILY_LIMIT %> in 24 hours) so the sender isn't rejected mid-run.
      <% if (room = Admin::MailQuota.room_at) %>Room again from <%= l(room, format: :short) %>; then press Resume.<% end %>
    </p>
<% end %>

<section class="main-content__body main-content__body--flush">
  <table id="bulk-recipients">
    <thead><tr>
      <th>Recipient</th><th>Language</th>
      <th>Status</th><th>When</th></tr></thead>
    <tbody>
      <% @rows.each do |r| %>
        <tr>
          <td dir="auto"><%= link_to r.user.full_name.presence || r.user.email, admin_user_path(r.user) %></td>
          <td><%= names[r.locale] %></td>
          <td class="<%= 'hw-text-danger' if r.failed? %>"><%= r.status %><%= ": #{r.error}" if r.failed? && r.error.present? %></td>
          <td class="hw-nowrap hw-text-muted"><%= r.sent_at ? l(r.sent_at, format: :short) : "—" %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
  <%= paginate @rows %>
</section>

<% if @bulk.via_in_app? %>
  <h2 class="hw-section__title hw-gap-top">In-app deliveries</h2>
  <table id="bulk-in-app-recipients" class="hw-table">
    <thead><tr><th>Recipient</th><th>Language</th><th>Status</th><th>Push</th><th>When</th></tr></thead>
    <tbody>
      <% @in_app_rows.each do |r| %>
        <tr>
          <td><%= link_to r.user.full_name.presence || r.user.email, admin_user_path(r.user) %></td>
          <td><%= names[r.locale] %></td>
          <td><%= r.status %><%= ": #{r.error}" if r.error.present? %></td>
          <td><%= r.push_note %></td>
          <td><%= r.sent_at ? l(r.sent_at, format: :short) : "—" %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% end %>

<% if @bulk.sending? %>
  <script>setTimeout(function () { if (document.visibilityState === "visible") location.reload(); }, 10000);</script>
<% end %>
