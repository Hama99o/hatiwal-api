<%# All four language versions of one admin message, used by one-to-one
    Messages and bulk alike (Admin::LanguageVersions).

    Locals:
      counts          { "en" => n, "ps" => n, …, "other" => n } readers per language
      raw             the submitted content, to refill the boxes
      fallback        the chosen fallback locale
      follow_channel  true: subject boxes show only while #channel-email is ticked
                      (in-app messages have no subject); false: always shown
      highlight       optional [locale, first_name] — "Zarmina reads Pashto: this
                      box is what she gets" (one-to-one)

    Class names (.bulk-lang/.bulk-subject/.bulk-body/.fallback-warning/
    .fallback-badge, #fallback-locale) are read by the script below and specs. %>
<% names = Admin::LanguageVersions::NAMES %>
<% hl_locale, hl_name = highlight %>
<label class="ad-inline-select">
  <strong>Fallback language</strong> — for anyone whose language box is empty:
  <%= select_tag :fallback_locale, options_for_select(Admin::LanguageVersions::LOCALES.map { |l| [ names[l], l ] }, fallback),
        id: "fallback-locale", class: "ad-select" %>
</label>
<% if hl_name && !Admin::LanguageVersions::LOCALES.include?(hl_locale) %>
  <p class="ad-note ad-step" id="reader-note"><%= hl_name %> has no language set, so gets the fallback version.</p>
<% elsif !hl_name && counts["other"].to_i.positive? %>
  <p class="ad-note ad-step"><%= counts["other"] %> recipient(s) have no language set and always get the fallback.</p>
<% end %>

<div class="ad-lang-grid">
  <% Admin::LanguageVersions::LOCALES.each do |loc| %>
    <% rtl = %w[ps fa ur].include?(loc) %>
    <% n = counts[loc].to_i %>
    <fieldset class="bulk-lang ad-lang" data-locale="<%= loc %>" data-count="<%= n %>">
      <legend>
        <%= names[loc] %> — <span class="lang-count"><%= n %></span> recipient<%= "s" unless n == 1 %>
        <%# The inline display is STATE, not styling: the script below toggles it. %>
        <span class="fallback-badge ad-lang__badge"<% unless loc == fallback %> style="display:none;"<% end %>>(fallback)</span>
      </legend>
      <% if hl_name && loc == hl_locale %>
        <p class="reader-mark ad-lang__reader"><%= hl_name %> reads <%= names[loc] %>: this box is what <%= hl_name %> gets.</p>
      <% end %>
      <div class="lang-subject">
        <%= text_field_tag "content[#{loc}][subject]", raw.dig(loc, "subject"), placeholder: "Subject (email)",
              dir: (rtl ? "rtl" : "ltr"), maxlength: AdminEmail::SUBJECT_MAX, class: "bulk-subject ad-input" %>
      </div>
      <%= text_area_tag "content[#{loc}][body]", raw.dig(loc, "body"), rows: 6, placeholder: "Message",
            dir: (rtl ? "rtl" : "ltr"), maxlength: AdminEmail::BODY_MAX, class: "bulk-body ad-textarea" %>
      <p class="fallback-warning ad-lang__warn"></p>
    </fieldset>
  <% end %>
</div>

<%# Live: subjects follow the Email channel, and an empty box that has readers
    says, right there, who gets what instead. %>
<script>
  (function () {
    var names = <%= raw Admin::LanguageVersions::NAMES.to_json %>;
    var followChannel = <%= follow_channel ? "true" : "false" %>;
    var fb = document.getElementById("fallback-locale");
    var form = fb.closest("form");
    function subjectsOn() {
      if (!followChannel) return true;
      var email = document.getElementById("channel-email");
      return !!(email && email.checked);
    }
    function filled(set) {
      var bodyOk = set.querySelector(".bulk-body").value.trim() !== "";
      return bodyOk && (!subjectsOn() || set.querySelector(".bulk-subject").value.trim() !== "");
    }
    function refresh() {
      var on = subjectsOn();
      document.querySelectorAll(".lang-subject").forEach(function (el) { el.style.display = on ? "" : "none"; });
      document.querySelectorAll(".bulk-lang").forEach(function (set) {
        var loc = set.dataset.locale, n = parseInt(set.dataset.count, 10), w = set.querySelector(".fallback-warning");
        set.querySelector(".fallback-badge").style.display = loc === fb.value ? "" : "none";
        if (loc === fb.value) {
          w.textContent = filled(set) ? "" : "Required: this is the fallback version.";
        } else if (n > 0 && !filled(set)) {
          w.textContent = "Empty: " + (n === 1 ? "this 1 will" : "these " + n + " will") + " receive the " + names[fb.value] + " version.";
        } else {
          w.textContent = "";
        }
      });
    }
    form.addEventListener("input", refresh);
    form.addEventListener("change", refresh);
    refresh();
  })();
</script>
