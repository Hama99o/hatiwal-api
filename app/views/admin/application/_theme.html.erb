<%# Hatiwal admin theme — layered on top of Administrate's default stylesheet to
    give the dashboard a modern, branded look (indigo accent, card panels,
    cleaner tables/buttons). Rendered after `_stylesheet` so it wins the cascade. %>
<style>
  :root {
    --ad-bg: #f1f5f9;
    --ad-surface: #ffffff;
    --ad-border: #e2e8f0;
    --ad-text: #0f172a;
    --ad-muted: #64748b;
    --ad-primary: #6366f1;
    --ad-primary-dark: #4f46e5;
    --ad-danger: #dc2626;
  }

  body {
    background: var(--ad-bg);
    color: var(--ad-text);
    -webkit-font-smoothing: antialiased;
  }

  /* ── Layout: sidebar + content ─────────────────────────────────────────── */
  .app-container {
    gap: 1.25rem;
    padding: 1.25rem;
    max-width: 110rem;
  }

  /* Sidebar as a sticky card */
  .navigation {
    flex: 0 0 15rem;
    align-self: flex-start;
    position: sticky;
    top: 1.25rem;
    background: var(--ad-surface);
    border: 1px solid var(--ad-border);
    border-radius: 14px;
    padding: 1rem;
    box-shadow: 0 1px 3px rgba(15, 23, 42, 0.04);
  }
  .navigation__link {
    border-radius: 9px;
    color: var(--ad-muted);
    font-weight: 500;
    padding: 0.6rem 0.8rem;
    margin: 0 0 2px;
    line-height: 1.2;
  }
  .navigation__link:hover {
    background: #f1f5f9;
    color: var(--ad-text);
    border-radius: 9px;
  }
  .navigation__link--active {
    background: var(--ad-primary);
    color: #ffffff;
    font-weight: 600;
  }
  .navigation__account p { color: var(--ad-muted); }

  /* Main content as a card */
  .main-content {
    background: var(--ad-surface);
    border: 1px solid var(--ad-border);
    border-radius: 14px;
    padding: 1.5rem 1.75rem;
    box-shadow: 0 1px 3px rgba(15, 23, 42, 0.04);
  }
  .main-content__page-title {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--ad-text);
  }

  /* ── Tables ────────────────────────────────────────────────────────────── */
  table { border-collapse: separate; border-spacing: 0; width: 100%; }
  thead th {
    background: #f8fafc;
    color: var(--ad-muted);
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    padding: 0.7rem 0.8rem;
    border-bottom: 1px solid var(--ad-border);
    text-align: start;
  }
  tbody td {
    padding: 0.7rem 0.8rem;
    border-bottom: 1px solid #f1f5f9;
    font-size: 0.9rem;
    color: var(--ad-text);
  }
  tbody tr:hover { background: #f8fafc; }

  /* ── Buttons ───────────────────────────────────────────────────────────── */
  .button,
  .button_to button,
  button.button,
  a.button {
    background: var(--ad-primary);
    color: #ffffff;
    border: none;
    border-radius: 9px;
    padding: 0.55rem 0.9rem;
    font-weight: 600;
    transition: background 0.15s ease-in-out;
  }
  .button:hover, a.button:hover, button.button:hover { background: var(--ad-primary-dark); }
  .button--danger, button.button--danger { background: var(--ad-danger); }
  .button--danger:hover, button.button--danger:hover { background: #b91c1c; }
  .button--alt, .button--nav,
  a.button--alt, a.button--nav {
    background: #f1f5f9;
    color: var(--ad-text);
  }
  .button--alt:hover, .button--nav:hover { background: #e2e8f0; }

  /* ── Misc ──────────────────────────────────────────────────────────────── */
  a { color: var(--ad-primary); }
  .search__input {
    border: 1px solid var(--ad-border);
    border-radius: 9px;
    padding: 0.55rem 0.8rem;
  }
  .flash { border-radius: 10px; }
  /* ── Index filter bar ────────────────────────────────────────────────────
     Combinable filters, as opposed to Administrate's COLLECTION_FILTERS links
     above it. Uses the variables declared at the top of this file so it tracks
     the theme instead of hardcoding colours. */
  .filter-bar {
    background: var(--ad-surface);
    border: 1px solid var(--ad-border);
    border-radius: 10px;
    padding: 14px 16px;
    margin: 0 0 16px;
  }
  .filter-bar__form { display: flex; flex-wrap: wrap; align-items: flex-end; gap: 14px; }
  .filter-bar__fields { display: flex; flex-wrap: wrap; gap: 14px; flex: 1 1 auto; }
  .filter-bar__field { display: flex; flex-direction: column; gap: 4px; }
  .filter-bar__label {
    font-size: 11px; font-weight: 600; letter-spacing: .04em;
    text-transform: uppercase; color: var(--ad-muted);
  }
  .filter-bar__input {
    border: 1px solid var(--ad-border); border-radius: 7px;
    padding: 7px 10px; font-size: 13px; color: var(--ad-text);
    background: #fff; min-width: 130px; height: 36px; box-sizing: border-box;
  }
  .filter-bar__input:focus {
    outline: none; border-color: var(--ad-primary);
    box-shadow: 0 0 0 3px rgba(99, 102, 241, .15);
  }
  .filter-bar__range { display: flex; align-items: center; gap: 6px; }
  .filter-bar__range .filter-bar__input { min-width: 120px; }
  .filter-bar__to { font-size: 12px; color: var(--ad-muted); }
  .filter-bar__actions { display: flex; align-items: center; gap: 12px; }
  .filter-bar__apply {
    background: var(--ad-primary); border: 0; color: #fff; cursor: pointer;
    border-radius: 7px; padding: 0 18px; height: 36px; font-size: 13px; font-weight: 600;
  }
  .filter-bar__apply:hover { background: var(--ad-primary-dark); }
  .filter-bar__clear { font-size: 13px; color: var(--ad-muted); text-decoration: underline; }

</style>
