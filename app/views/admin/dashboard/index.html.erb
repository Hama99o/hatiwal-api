<% content_for(:title) { "Dashboard" } %>

<%# Chartkick needs a charting backend. This API app has no JS bundler, so we
    load Chart.js + Chartkick from a CDN (acceptable for an internal admin tool).
    Must come BEFORE the chart helpers below so the Chartkick global exists.
    The date-fns adapter is required for the line charts' time axis (the weekly
    growth series) — without it Chart.js errors with "no complete date adapter". %>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4"></script>
<script src="https://cdn.jsdelivr.net/npm/chartjs-adapter-date-fns@3/dist/chartjs-adapter-date-fns.bundle.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chartkick@5/dist/chartkick.min.js"></script>
<%# Charts in the page's own type and colours (docs/design/ADMIN_DESIGN.md). %>
<script>
  if (window.Chart) {
    Chart.defaults.font.family = getComputedStyle(document.body).fontFamily;
    Chart.defaults.color = "#64748b";
    Chart.defaults.borderColor = "#eef1f6";
  }
</script>

<%
  # Chart colours = the brand tokens in admin.css. Listing statuses keep one
  # meaning everywhere: lapis = live, gold = held, green = sold, grey = draft.
  status_colors = { "active" => "#12224f", "reserved" => "#e8b23a", "sold" => "#15803d", "draft" => "#a3adbf" }
  dead_platforms = @push_reach.select { |_, r| r[:users].positive? && r[:with_token].zero? }
  period_cfg = Admin::GrowthSeries::PERIODS[@growth_period]
  # Solid bars with rounded ends (Chartkick's default is a translucent fill,
  # which turns the lapis grey).
  bar_style = { borderWidth: 0, borderRadius: 4, maxBarThickness: 36 }
%>

<header class="ad-page-header">
  <div>
    <h1 class="ad-page-header__title main-content__page-title">Dashboard</h1>
    <p class="ad-page-header__subtitle">How the marketplace is doing, on Kabul time.</p>
  </div>
</header>

<%# Needs attention: the things to act on, before any number. Each item only
    appears when it is true, and links to where it is dealt with. %>
<% if @stats[:reports_pending].positive? || dead_platforms.any? %>
  <div class="ad-alerts" id="attention">
    <% if @stats[:reports_pending].positive? %>
      <div class="ad-alert ad-alert--warning">
        <span class="ad-alert__dot"></span>
        <div class="ad-alert__body">
          <span class="ad-alert__title"><%= pluralize(@stats[:reports_pending], "report") %> waiting for review.</span>
        </div>
        <%= link_to "Review", admin_reports_path %>
      </div>
    <% end %>
    <% dead_platforms.each do |platform, r| %>
      <div class="ad-alert ad-alert--danger">
        <span class="ad-alert__dot"></span>
        <div class="ad-alert__body">
          <span class="ad-alert__title"><%= platform == "ios" ? "iPhone" : "Android" %> users can't receive push notifications</span>
          — 0 of <%= r[:users] %> hold a push token.
        </div>
        <a href="#push-reach">Why</a>
      </div>
    <% end %>
  </div>
<% end %>

<section class="ad-section">
  <div class="ad-section__head"><h2 class="ad-section__title">Users</h2></div>
  <div class="ad-metrics">
    <div class="ad-metric ad-metric--primary"><span class="ad-metric__label">Total users</span><span class="ad-metric__value"><%= @stats[:users_total] %></span></div>
    <div class="ad-metric"><span class="ad-metric__label">Active</span><span class="ad-metric__value"><%= @stats[:users_active] %></span></div>
    <div class="ad-metric"><span class="ad-metric__label">Verified</span><span class="ad-metric__value"><%= @stats[:users_verified] %></span></div>
    <div class="ad-metric"><span class="ad-metric__label">Sellers</span><span class="ad-metric__value"><%= @stats[:users_sellers] %></span></div>
  </div>
</section>

<section class="ad-section">
  <div class="ad-section__head"><h2 class="ad-section__title">Listings &amp; moderation</h2></div>
  <div class="ad-metrics">
    <div class="ad-metric ad-metric--primary"><span class="ad-metric__label">Total listings</span><span class="ad-metric__value"><%= @stats[:listings_total] %></span></div>
    <div class="ad-metric"><span class="ad-metric__label">Active</span><span class="ad-metric__value"><%= @stats[:listings_active] %></span></div>
    <div class="ad-metric"><span class="ad-metric__label">Reserved</span><span class="ad-metric__value"><%= @stats[:listings_reserved] %></span></div>
    <div class="ad-metric"><span class="ad-metric__label">Sold</span><span class="ad-metric__value"><%= @stats[:listings_sold] %></span></div>
    <div class="ad-metric"><span class="ad-metric__label">Drafts</span><span class="ad-metric__value"><%= @stats[:listings_draft] %></span></div>
    <div class="ad-metric<%= ' ad-metric--attention' if @stats[:reports_pending].positive? %>"><span class="ad-metric__label">Pending reports</span><span class="ad-metric__value"><%= @stats[:reports_pending] %></span></div>
    <div class="ad-metric"><span class="ad-metric__label">Categories</span><span class="ad-metric__value"><%= @stats[:categories_total] %></span></div>
  </div>
</section>

<section class="ad-section" id="growth">
  <div class="ad-section__head">
    <h2 class="ad-section__title">Growth — <%= period_cfg[:label].downcase %></h2>
    <nav class="ad-segmented" aria-label="Growth period">
      <% Admin::GrowthSeries::PERIODS.each_key do |key| %>
        <%= link_to key.capitalize, admin_root_path(period: key, anchor: "growth"),
              class: "growth-period#{' growth-period--active' if key == @growth_period}",
              "aria-current": (key == @growth_period ? "page" : nil) %>
      <% end %>
    </nav>
  </div>
  <div class="ad-grid-2">
    <div class="ad-card">
      <h3 class="ad-card__title">New users</h3>
      <p class="ad-card__headline"><%= @new_users.values.sum %></p>
      <p class="ad-card__sub">
        In this range. Sign-ups as they happened, including accounts deleted since
        (<%= @new_users_since_deleted %> of these).
      </p>
      <%= column_chart Admin::GrowthSeries.labelled(@new_users, @growth_period), height: "240px",
            colors: ["#12224f"], dataset: bar_style.merge(backgroundColor: "#12224f"), download: true, id: "chart-new-users", discrete: true %>
    </div>
    <div class="ad-card">
      <h3 class="ad-card__title">New listings</h3>
      <p class="ad-card__headline"><%= @new_listings.values.sum %></p>
      <p class="ad-card__sub">In this range.</p>
      <%= column_chart Admin::GrowthSeries.labelled(@new_listings, @growth_period), height: "240px",
            colors: ["#e8b23a"], dataset: bar_style.merge(backgroundColor: "#e8b23a"), download: true, id: "chart-new-listings", discrete: true %>
    </div>
  </div>
  <p class="ad-note">
    Counted on Kabul time (UTC+04:30)<%= "; weeks start on Saturday, and each bar is labelled with the Saturday its week begins" if @growth_period == "week" %>.
    The current <%= @growth_period %> is still in progress.
  </p>
</section>

<section class="ad-section">
  <div class="ad-section__head"><h2 class="ad-section__title">Composition</h2></div>
  <div class="ad-grid-2">
    <div class="ad-card">
      <h3 class="ad-card__title">Listings by status</h3>
      <p class="ad-card__sub">Every listing, whatever its status.</p>
      <%= pie_chart @listings_by_status, height: "240px", donut: true, legend: "bottom",
            colors: @listings_by_status.keys.map { |k| status_colors.fetch(k.to_s, "#64748b") } %>
    </div>
    <div class="ad-card">
      <h3 class="ad-card__title">Top categories</h3>
      <p class="ad-card__sub">The 8 categories with the most listings.</p>
      <%= bar_chart @top_categories, height: "240px", colors: ["#3a63d6"], dataset: bar_style.merge(backgroundColor: "#3a63d6") %>
    </div>
  </div>
</section>

<%# Technical health: which builds are out there, and whether pushes reach them.
    Last, because it is read before a release, not every morning. %>
<section class="ad-section" id="app-versions">
  <div class="ad-section__head"><h2 class="ad-section__title">App versions <span class="ad-metric__of">· users seen in the last 30 days</span></h2></div>
  <div class="ad-grid-auto">
    <div class="ad-tile" data-metric="legacy-clients">
      <span class="ad-metric__label">On v1.0.4 or older (app sends no version)</span>
      <span class="ad-metric__value"><%= @legacy_clients %></span>
    </div>
    <% @app_versions.each do |(platform, version), count| %>
      <div class="ad-tile">
        <span class="ad-metric__label">v<%= version %> · <%= platform.presence || "unknown platform" %></span>
        <span class="ad-metric__value"><%= count %></span>
      </div>
    <% end %>
  </div>
  <p class="ad-note">
    Check the first number before switching on anything an old build can't show
    (e.g. <code>SUPPORT_ADMIN_INITIATE</code>). Someone using two phones can be counted twice.
  </p>
</section>

<section class="ad-section" id="push-reach">
  <div class="ad-section__head"><h2 class="ad-section__title">Push notifications — can they reach people?</h2></div>
  <div class="ad-grid-2">
    <% @push_reach.each do |platform, r| %>
      <% dead = r[:users].positive? && r[:with_token].zero? %>
      <div class="ad-tile<%= ' ad-tile--danger' if dead %>" data-platform="<%= platform %>">
        <span class="ad-metric__label"><%= platform == "ios" ? "iPhone" : "Android" %> users who can receive pushes</span>
        <span class="ad-metric__value"><%= r[:with_token] %> <span class="ad-metric__of">of <%= r[:users] %></span></span>
        <% if r[:reasons].any? %>
          <div class="ad-reasons">
            <div class="ad-reasons__title">Why, as the apps report it:</div>
            <%# Client-supplied text: output-escaped by ERB, never raw / html_safe. %>
            <% r[:reasons].each do |reason, count| %>
              <div class="ad-reasons__item"><code><%= reason %></code> × <%= count %></div>
            <% end %>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>
  <p class="ad-note">
    Users whose app reported its platform in the last 30 days, and how many hold a push token.
    Red means nobody on that platform can get a notification — on Android, that is Firebase not
    being configured in the app build (docs/PUSH_NOTIFICATIONS.md).
  </p>
</section>
