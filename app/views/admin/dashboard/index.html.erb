<% content_for(:title) { "Dashboard" } %>

<%# Chartkick needs a charting backend. This API app has no JS bundler, so we
    load Chart.js + Chartkick from a CDN (acceptable for an internal admin tool).
    Must come BEFORE the chart helpers below so the Chartkick global exists.
    The date-fns adapter is required for the line charts' time axis (the weekly
    growth series) — without it Chart.js errors with "no complete date adapter". %>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4"></script>
<script src="https://cdn.jsdelivr.net/npm/chartjs-adapter-date-fns@3/dist/chartjs-adapter-date-fns.bundle.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chartkick@5/dist/chartkick.min.js"></script>

<style>
  .dash-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: 1rem; margin: 1rem 0 2rem; }
  .dash-card { background: #fff; border: 1px solid #e2e8f0; border-radius: 12px; padding: 1.1rem 1.25rem; }
  .dash-card .num { font-size: 1.9rem; font-weight: 700; line-height: 1.1; }
  .dash-card .label { font-size: .8rem; color: #64748b; margin-top: .25rem; }
  .dash-section { margin-bottom: 2.5rem; }
  .dash-section h2 { font-size: 1rem; color: #334155; margin: 0 0 .75rem; }
  .dash-charts { display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; }
  @media (max-width: 900px) { .dash-charts { grid-template-columns: 1fr; } }
  .growth-period { padding: .25rem .65rem; border: 1px solid #e2e8f0; border-radius: 999px; color: #475569; text-decoration: none; }
  .growth-period--active { background: #6366f1; border-color: #6366f1; color: #fff; }
</style>

<header class="main-content__header">
  <h1 class="main-content__page-title">Dashboard</h1>
</header>

<section class="dash-section">
  <h2>Users</h2>
  <div class="dash-grid">
    <div class="dash-card"><div class="num"><%= @stats[:users_total] %></div><div class="label">Total users</div></div>
    <div class="dash-card"><div class="num"><%= @stats[:users_sellers] %></div><div class="label">Sellers</div></div>
    <div class="dash-card"><div class="num"><%= @stats[:users_verified] %></div><div class="label">Verified</div></div>
    <div class="dash-card"><div class="num"><%= @stats[:users_active] %></div><div class="label">Active</div></div>
  </div>
</section>

<section class="dash-section">
  <h2>Listings &amp; reports</h2>
  <div class="dash-grid">
    <div class="dash-card"><div class="num"><%= @stats[:listings_total] %></div><div class="label">Total listings</div></div>
    <div class="dash-card"><div class="num"><%= @stats[:listings_active] %></div><div class="label">Active</div></div>
    <div class="dash-card"><div class="num"><%= @stats[:listings_reserved] %></div><div class="label">Reserved</div></div>
    <div class="dash-card"><div class="num"><%= @stats[:listings_sold] %></div><div class="label">Sold</div></div>
    <div class="dash-card"><div class="num"><%= @stats[:listings_draft] %></div><div class="label">Drafts</div></div>
    <div class="dash-card"><div class="num"><%= @stats[:reports_pending] %></div><div class="label">Pending reports</div></div>
    <div class="dash-card"><div class="num"><%= @stats[:categories_total] %></div><div class="label">Categories</div></div>
  </div>
</section>

<section class="dash-section" id="app-versions">
  <h2>App versions (users seen in the last 30 days)</h2>
  <div class="dash-grid">
    <div class="dash-card">
      <div class="num"><%= @legacy_clients %></div>
      <div class="label">On v1.0.4 or older (app sends no version)</div>
    </div>
    <% @app_versions.each do |(platform, version), count| %>
      <div class="dash-card">
        <div class="num"><%= count %></div>
        <div class="label">v<%= version %> · <%= platform.presence || "unknown platform" %></div>
      </div>
    <% end %>
  </div>
  <p style="font-size:.8rem;color:#64748b;margin:.25rem 0 0;">
    Check the first number before switching on anything an old build can't show
    (e.g. <code>SUPPORT_ADMIN_INITIATE</code>). Someone using two phones can be counted twice.
  </p>
</section>

<section class="dash-section" id="growth">
  <div style="display:flex;justify-content:space-between;align-items:baseline;gap:1rem;flex-wrap:wrap;">
    <h2>Growth — <%= Admin::GrowthSeries::PERIODS[@growth_period][:label].downcase %></h2>
    <nav aria-label="Growth period" style="display:flex;gap:.35rem;font-size:.85rem;">
      <% Admin::GrowthSeries::PERIODS.each do |key, cfg| %>
        <%= link_to key.capitalize, admin_root_path(period: key, anchor: "growth"),
              class: "growth-period#{' growth-period--active' if key == @growth_period}",
              "aria-current": (key == @growth_period ? "page" : nil) %>
      <% end %>
    </nav>
  </div>
  <p style="font-size:.78rem;color:#64748b;margin:.1rem 0 .75rem;">
    Counted on Kabul time (UTC+04:30)<%= "; weeks start on Saturday" if @growth_period == "week" %>.
    The current <%= @growth_period %> is still in progress.
  </p>
  <div class="dash-charts">
    <div>
      <h3 style="font-size:.85rem;color:#475569;margin:0 0 .4rem;">New users — <%= @new_users.values.sum %> in this range</h3>
      <p style="font-size:.75rem;color:#64748b;margin:-.25rem 0 .4rem;">
        Sign-ups as they happened, including accounts deleted since
        (<%= @new_users_since_deleted %> of these).
      </p>
      <%= column_chart @new_users, height: "260px", colors: ["#6366f1"], download: true,
            id: "chart-new-users", discrete: @growth_period == "year" %>
    </div>
    <div>
      <h3 style="font-size:.85rem;color:#475569;margin:0 0 .4rem;">New listings — <%= @new_listings.values.sum %> in this range</h3>
      <%= column_chart @new_listings, height: "260px", colors: ["#10b981"], download: true,
            id: "chart-new-listings", discrete: @growth_period == "year" %>
    </div>
  </div>
</section>

<section class="dash-section">
  <h2>Composition</h2>
  <div class="dash-charts">
    <div><%= pie_chart @listings_by_status, height: "260px" %></div>
    <div><%= column_chart @top_categories, height: "260px", colors: ["#f59e0b"] %></div>
  </div>
</section>
