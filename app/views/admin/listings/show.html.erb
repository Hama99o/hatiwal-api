<%# A listing's admin page: Administrate's header with the listing's status
    beside the title, then the take-down panel, then every field. The panel
    sits in Administrate's :before_main hook. Taking down hides the listing
    from the public feed and detail page. %>

<% listing = page.resource %>

<% content_for(:header_middle) do %>
  <span class="ad-badges">
    <% if listing.removed? %>
      <span class="ad-badge ad-badge--danger">Taken down</span>
    <% end %>
    <span class="ad-badge <%= { 'active' => 'ad-badge--brand', 'reserved' => 'ad-badge--gold', 'sold' => 'ad-badge--success' }.fetch(listing.status.to_s, '') %>"><%= listing.status.to_s.humanize %></span>
  </span>
<% end %>

<% content_for(:before_main) do %>
<div class="ad-panels">
  <section class="ad-panel ad-panel--danger ad-panel--wide">
    <div class="ad-panel__head"><h2 class="ad-panel__title">Listing moderation</h2></div>
    <% if listing.removed? %>
      <div class="ad-callout ad-callout--danger">
        This listing was <strong>taken down</strong> on <%= listing.removed_at.strftime("%Y-%m-%d") %> —
        it is hidden from buyers.
        <% if listing.removed_reason.present? %>
          <br>Reason: <em dir="auto"><%= listing.removed_reason %></em>
        <% end %>
      </div>
      <%= button_to "Restore listing", restore_admin_listing_path(listing),
            method: :patch, data: { turbo: false }, class: "button" %>
    <% else %>
      <p class="ad-panel__text">
        Take down a spam/illegal/prohibited listing — it disappears from the buyer
        feed and detail page immediately (the record is kept).
      </p>
      <%= form_with url: take_down_admin_listing_path(listing), method: :patch, data: { turbo: false }, class: "ad-form-row" do |f| %>
        <%= f.text_field :removed_reason, placeholder: "Reason (optional)", class: "ad-input", dir: "auto" %>
        <%= f.submit "Take down listing", class: "button button--danger",
              data: { confirm: "Take down “#{listing.title}”?" } %>
      <% end %>
    <% end %>
  </section>
</div>
<h2 class="ad-section__title ad-record-title">All fields</h2>
<% end %>

<%= render template: "administrate/application/show", locals: { page: page } %>
