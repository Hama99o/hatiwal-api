<%# VID / SHOP-MEDIA: a record's video (a HasVideo model) for moderation.
    preload="none": nothing downloads until the admin presses play. Locals:
    record (required), remove_path (optional — shows "Remove video").
    Relative blob paths: the admin is the same app, and its controllers do not
    set Active Storage's url_options (record.video_url would be nil here). %>
<% if record.has_video? %>
  <div class="hw-listing-video" id="record-video">
    <video controls preload="none" playsinline width="320"
           src="<%= main_app.rails_blob_path(record.video) %>"
           <% if record.video_poster.attached? %>poster="<%= main_app.rails_blob_path(record.video_poster) %>"<% end %>></video>
    <p class="hw-panel__text">
      Video<%= " · #{record.video_duration_s} s" if record.video_duration_s %>
      · <%= number_to_human_size(record.video.blob.byte_size) %>
    </p>
    <% if local_assigns[:remove_path] %>
      <%= button_to "Remove video", remove_path,
            method: :patch, data: { turbo: false, confirm: "Remove this video? The photos stay." },
            class: "button button--danger", id: "remove-record-video" %>
    <% end %>
  </div>
<% end %>
