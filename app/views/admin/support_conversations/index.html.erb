<% content_for(:title) { "Support" } %>

<header class="main-content__header">
  <h1 class="main-content__page-title">Support (<%= @total %>)</h1>
</header>

<section class="main-content__body">
  <% unless admin_initiate_enabled? %>
    <p style="margin:0 0 1rem;padding:.7rem .9rem;border:1px solid #e2e8f0;border-radius:8px;background:#f8fafc;font-size:.85rem;color:#475569;">
      Only users can start a support conversation for now. Starting one from a user's page is
      turned off until the app update with support messaging is live
      (<code>SUPPORT_ADMIN_INITIATE</code>).
    </p>
  <% end %>

  <% if @conversations.any? %>
    <table id="support-inbox" style="width:100%;border-collapse:collapse;font-size:.9rem;">
      <thead>
        <tr style="text-align:start;color:#64748b;font-size:.75rem;text-transform:uppercase;letter-spacing:.04em;">
          <th style="padding:.5rem;">User</th>
          <th style="padding:.5rem;">Last message</th>
          <th style="padding:.5rem;">Unread</th>
          <th style="padding:.5rem;">Status</th>
          <th style="padding:.5rem;">Last activity</th>
        </tr>
      </thead>
      <tbody>
        <% @conversations.each do |c| %>
          <% unread = @unread_counts[c.id].to_i %>
          <tr style="border-top:1px solid #e2e8f0;<%= 'font-weight:600;' if unread.positive? %>">
            <td style="padding:.55rem .5rem;"><%= link_to c.buyer.full_name.presence || "User ##{c.buyer_id}", admin_support_conversation_path(c) %></td>
            <td style="padding:.55rem .5rem;color:#475569;"><%= c.latest_message&.body.to_s.truncate(80) %></td>
            <td style="padding:.55rem .5rem;"><%= unread.positive? ? unread : "" %></td>
            <td style="padding:.55rem .5rem;"><%= c.status %></td>
            <td style="padding:.55rem .5rem;color:#64748b;"><%= c.last_message_at ? "#{time_ago_in_words(c.last_message_at)} ago" : "—" %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
    <%= paginate @conversations %>
  <% else %>
    <p style="color:#64748b;">No support conversations yet.</p>
  <% end %>
</section>

<%# New messages show up without anyone pressing reload. Plain polling, by
    design: no websockets in the admin. Paused while the tab is hidden. %>
<script>
  setInterval(function () {
    if (document.visibilityState === "visible") window.location.reload();
  }, <%= Admin::SupportConversationsController::REFRESH_SECONDS * 1000 %>);
</script>
