<% content_for(:title) { "Support" } %>

<header class="ad-page-header">
  <div>
    <h1 class="ad-page-header__title main-content__page-title">Support (<%= @total %>)</h1>
    <p class="ad-page-header__subtitle">Conversations users started with Hatiwal Support. Awaiting a reply come first.</p>
  </div>
</header>

<% unless admin_initiate_enabled? %>
  <div class="ad-callout">
    Only users can start a support conversation for now. Starting one from a user's page is
    turned off until the app update with support messaging is live
    (<code>SUPPORT_ADMIN_INITIATE</code>).
  </div>
<% end %>

<section class="main-content__body main-content__body--flush">
  <% if @conversations.any? %>
    <table id="support-inbox">
      <thead>
        <tr>
          <th>User</th>
          <th>Last message</th>
          <th>Unread</th>
          <th>Status</th>
          <th>Last activity</th>
        </tr>
      </thead>
      <tbody>
        <% @conversations.each do |c| %>
          <% unread = @unread_counts[c.id].to_i %>
          <tr class="<%= 'ad-inbox-row--unread' if unread.positive? %>">
            <td class="ad-nowrap" dir="auto"><%= link_to c.buyer.full_name.presence || "User ##{c.buyer_id}", admin_support_conversation_path(c) %></td>
            <td class="ad-text-muted" dir="auto"><%= c.latest_message&.body.to_s.truncate(80) %></td>
            <td><% if unread.positive? %><span class="ad-count"><%= unread %></span><% end %></td>
            <td><span class="ad-badge <%= c.open? ? 'ad-badge--success' : 'ad-badge--plain' %>"><%= c.status %></span></td>
            <td class="ad-nowrap ad-text-muted"><%= c.last_message_at ? "#{time_ago_in_words(c.last_message_at)} ago" : "—" %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
    <%= paginate @conversations %>
  <% else %>
    <p class="ad-empty ad-pad">No support conversations yet.</p>
  <% end %>
</section>

<%# New messages show up without anyone pressing reload. Plain polling, by
    design: no websockets in the admin. Paused while the tab is hidden. %>
<script>
  setInterval(function () {
    if (document.visibilityState === "visible") window.location.reload();
  }, <%= Admin::SupportConversationsController::REFRESH_SECONDS * 1000 %>);
</script>
