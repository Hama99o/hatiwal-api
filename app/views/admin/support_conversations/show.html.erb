<% user = @conversation.buyer %>
<% content_for(:title) { "Support — #{user.full_name}" } %>

<header class="hw-page-header">
  <div>
    <h1 class="hw-page-header__title main-content__page-title">
      Support — <%= link_to user.full_name.presence || "User ##{user.id}", admin_user_path(user), dir: "auto" %>
    </h1>
    <p class="hw-page-header__subtitle">
      <%= user.email %> · language: <%= user.preferred_language.presence || "—" %> ·
      <span class="hw-badge <%= @conversation.open? ? 'hw-badge--success' : 'hw-badge--plain' %>"><%= @conversation.status %></span>
    </p>
  </div>
  <div class="hw-actions">
    <%= link_to "← All support", admin_support_conversations_path, class: "button button--alt" %>
    <% if @conversation.open? %>
      <%= button_to "Close", close_admin_support_conversation_path(@conversation), method: :patch,
            data: { turbo: false }, class: "button button--alt" %>
    <% else %>
      <%= button_to "Reopen", reopen_admin_support_conversation_path(@conversation), method: :patch,
            data: { turbo: false }, class: "button" %>
    <% end %>
  </div>
</header>

<% if user.push_token.blank? %>
  <p id="support-no-push" class="hw-callout hw-callout--warning">
    This user can't receive push notifications (no push token<%= " — Android builds have no Firebase yet" if user.last_app_platform == "android" %>).
    Your reply will reach them only when they next open the app.
  </p>
<% end %>

<section class="hw-card">
  <div id="support-thread" class="hw-thread">
    <% @messages.each do |m| %>
      <% from_support = m.user_id == @conversation.seller_id %>
      <div class="hw-bubble<%= ' hw-bubble--support' if from_support %>">
        <% if m.deleted? %>
          <em class="hw-bubble__deleted">Message deleted</em>
        <% else %>
          <div class="hw-bubble__body" dir="auto"><%= m.body %></div>
          <% if m.attachment.attached? %>
            <div class="hw-gap-top"><%= link_to "📎 #{m.attachment.filename}", rails_blob_path(m.attachment, disposition: "inline"), target: "_blank", rel: "noopener" %></div>
          <% end %>
        <% end %>
        <div class="hw-bubble__meta">
          <% unless from_support %>
            <%# Where the person wrote from (one thread for every mode and shop). %>
            <% ctx = m.context || {} %>
            <span class="hw-badge hw-badge--plain" data-context="<%= ctx['shop_id'] ? 'shop' : ctx['mode'].presence || 'unknown' %>">
              <% if ctx["shop_id"] && (ctx_shop = Shop.find_by(id: ctx["shop_id"])) %>
                as <%= link_to ctx_shop.name, admin_shop_path(ctx_shop) %> (<%= ctx["role"].to_s.humanize %>)
              <% elsif ctx["mode"] == "seller" %>
                as seller (Me)
              <% elsif ctx["mode"] == "buyer" %>
                as buyer
              <% else %>
                unknown (older app)
              <% end %>
            </span>
          <% end %>
          <%= from_support ? "Support#{" · #{m.admin_user.email}" if m.admin_user}" : user.full_name %>
          · <%= l(m.created_at, format: :short) %>
        </div>
      </div>
    <% end %>
    <% if @messages.empty? %>
      <p class="hw-empty">No messages yet.</p>
    <% end %>
  </div>

  <% if @conversation.open? %>
    <%= form_with url: reply_admin_support_conversation_path(@conversation), method: :post,
          data: { turbo: false }, id: "support-reply", class: "hw-composer" do |f| %>
      <%= f.text_area :body, rows: 4, required: true, maxlength: 1000, dir: "auto", class: "hw-textarea",
            placeholder: "Reply as Hatiwal Support — the user gets it in the app and as a push." %>
      <div class="hw-composer__bar">
        <p id="support-refresh-note" class="hw-note"></p>
        <%= f.submit "Send reply", class: "button" %>
      </div>
    <% end %>
  <% else %>
    <p class="hw-empty">This conversation is closed — the user can't reply. Reopen it to continue.</p>
  <% end %>
</section>

<%# Bring in the user's new messages every few seconds — but NEVER while the
    admin has typed something: a reload would throw the draft away. Plain
    polling by design (no websockets in the admin). %>
<script>
  (function () {
    var box = document.querySelector("#support-reply textarea");
    var note = document.getElementById("support-refresh-note");
    var last = document.querySelector("#support-thread > div:last-of-type");
    if (last && !window.location.hash) last.scrollIntoView({ block: "end" });

    setInterval(function () {
      var drafting = box && box.value.trim() !== "";
      if (note) note.textContent = drafting ? "Auto-refresh paused while you type a reply." : "";
      if (!drafting && document.visibilityState === "visible") window.location.reload();
    }, <%= Admin::SupportConversationsController::REFRESH_SECONDS * 1000 %>);
  })();
</script>
