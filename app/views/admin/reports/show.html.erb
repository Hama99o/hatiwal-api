<%# A report's admin page: Administrate's header with the report's status
    beside it, then the triage panel — see what was reported and act on it
    (take down listing / warn user) in one click, resolving the report at the
    same time — then every field. The panel sits in :before_main. %>

<%
  report = page.resource
  target = report.reportable
  is_listing = target.is_a?(Listing)
  is_user = target.is_a?(User)
  status_tone = { "pending" => "hw-badge--warning", "resolved" => "hw-badge--success" }.fetch(report.status.to_s, "")
%>

<% content_for(:header_middle) do %>
  <span class="hw-badges"><span class="hw-badge <%= status_tone %>"><%= report.status.to_s.humanize %></span></span>
<% end %>

<% content_for(:before_main) do %>
<div class="hw-panels">
  <section class="hw-panel hw-panel--brand hw-panel--wide">
    <div class="hw-panel__head">
      <h2 class="hw-panel__title">Triage — report #<%= report.id %> (<%= report.status %>)</h2>
    </div>

    <div class="hw-callout">
      <strong>Reason:</strong> <%= report.reason.to_s.humanize %>
      <% if report.description.present? %><br><strong>Details:</strong> <span dir="auto"><%= report.description %></span><% end %>
      <br><strong>Reported:</strong>
      <% if is_listing %>
        Listing — <%= link_to(target.title.presence || "Listing ##{target.id}", [ namespace, target ], dir: "auto") %>
        (seller: <span dir="auto"><%= target.user.full_name %></span>)<%= " — already taken down" if target.removed? %>
      <% elsif is_user %>
        User — <%= link_to(target.full_name.presence || "User ##{target.id}", [ namespace, target ], dir: "auto") %>
      <% else %>
        <%= target&.class&.name %> ##<%= target&.id %>
      <% end %>
    </div>

    <div class="hw-actions">
      <% if is_listing && !target.removed? %>
        <%= button_to "Take down listing & resolve", take_down_target_admin_report_path(report),
              method: :patch, data: { turbo: false, confirm: "Take down “#{target.title}” and resolve this report?" },
              class: "button button--danger" %>
      <% end %>

      <% if is_listing || is_user %>
        <%= button_to(is_listing ? "Warn seller & resolve" : "Warn user & resolve",
              warn_target_admin_report_path(report),
              method: :patch, data: { turbo: false }, class: "button") %>
      <% end %>

      <% unless report.resolved? %>
        <%= button_to "Mark resolved", resolve_admin_report_path(report),
              method: :patch, data: { turbo: false }, class: "button" %>
      <% end %>
      <% unless report.dismissed? %>
        <%= button_to "Dismiss", dismiss_admin_report_path(report),
              method: :patch, data: { turbo: false }, class: "button button--alt" %>
      <% end %>
    </div>

    <p class="hw-note">For a permanent ban, open the user above and use the block panel.</p>
  </section>
</div>
<h2 class="hw-section__title hw-record-title">All fields</h2>
<% end %>

<%= render template: "administrate/application/show", locals: { page: page } %>
