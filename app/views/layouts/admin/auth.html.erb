<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="ROBOTS" content="NOINDEX, NOFOLLOW">
  <title>Admin sign in — Hatiwal</title>
  <link rel="icon" type="image/svg+xml" href="/icon.svg">
  <link rel="alternate icon" href="/favicon.ico">
  <%= csrf_meta_tags %>
  <%= stylesheet_link_tag "admin", "data-turbo-track": "reload" %>
</head>
<body class="auth-body">
  <div class="auth-card">
    <div class="auth-card__logo"><%= render "admin/application/logo", size: 56 %></div>
    <h1>Hatiwal Admin</h1>
    <p class="sub">Staff access only</p>

    <% if flash[:alert] %><div class="flash flash--alert"><%= flash[:alert] %></div><% end %>
    <% if flash[:notice] %><div class="flash flash--notice"><%= flash[:notice] %></div><% end %>

    <%= yield %>
  </div>
</body>
</html>
