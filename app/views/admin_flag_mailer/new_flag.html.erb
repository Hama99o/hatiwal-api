<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Flagged on Hatiwal</title>
</head>
<body style="margin:0;padding:0;background-color:#f4f6fb;font-family:'Helvetica Neue',Helvetica,Arial,sans-serif;color:#12224f;">
  <table width="100%" cellpadding="0" cellspacing="0" border="0" style="padding:32px 0;">
    <tr>
      <td align="center">
        <table width="100%" cellpadding="0" cellspacing="0" border="0" style="max-width:560px;background:#ffffff;border-radius:12px;border:1px solid #dde3f0;">
          <tr>
            <td style="padding:28px 32px;">
              <p style="margin:0 0 4px;font-size:13px;color:#c62828;font-weight:700;">Hatiwal Admin · Flagged <%= @flag.listing? ? "listing" : "shop" %></p>
              <h1 style="margin:0 0 16px;font-size:20px;" dir="auto"><%= @flag.flaggable_label %></h1>
              <table cellpadding="0" cellspacing="0" border="0" style="font-size:14px;line-height:1.6;">
                <tr><td style="color:#5b6785;padding-right:12px;">Matched term</td><td dir="auto"><strong><%= @flag.matched_term.presence || "— (reported)" %></strong></td></tr>
                <tr><td style="color:#5b6785;padding-right:12px;">Category</td><td><%= @flag.category ? @flag.category.humanize : "—" %></td></tr>
                <tr><td style="color:#5b6785;padding-right:12px;">Source</td><td><%= @flag.source.humanize %></td></tr>
              </table>
              <p style="margin:16px 0 20px;font-size:14px;color:#5b6785;">Nothing was blocked: the decision is yours.</p>
              <a href="<%= @url %>" style="display:inline-block;background:#1f3c88;color:#ffffff;text-decoration:none;padding:10px 18px;border-radius:8px;font-weight:600;font-size:14px;">Review the flag</a>
            </td>
          </tr>
        </table>
      </td>
    </tr>
  </table>
</body>
</html>
