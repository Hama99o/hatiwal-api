<%#
  Branded override of devise_token_auth's plain confirmation email, matching
  user_mailer/reset_password.html.erb.

  The URL is built exactly as DTA's own view builds it — `config` and
  `redirect_url` come off the message headers DTA sets in
  send_confirmation_instructions, and DTA's ConfirmationsController needs BOTH to
  redirect the user anywhere after confirming. Dropping either one turns the link
  into a dead end, which is why this is one shared local and not re-derived.
%>
<% confirm_url = confirmation_url(
     @resource,
     confirmation_token: @token,
     config:             message["client-config"].to_s,
     redirect_url:       message["redirect-url"]
   ) %>
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Confirm Your Email — Hatiwal</title>
</head>
<body style="margin:0;padding:0;background-color:#f4f4f7;font-family:'Helvetica Neue',Helvetica,Arial,sans-serif;">
  <table width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:#f4f4f7;padding:40px 0;">
    <tr>
      <td align="center">
        <table width="100%" cellpadding="0" cellspacing="0" border="0" style="max-width:560px;">

          <!-- Header -->
          <tr>
            <td align="center" style="padding-bottom:24px;">
              <span style="font-size:22px;font-weight:700;color:#12224F;letter-spacing:-0.5px;">Hatiwal</span>
            </td>
          </tr>

          <!-- Card -->
          <tr>
            <td style="background:#ffffff;border-radius:12px;padding:40px 48px;box-shadow:0 2px 8px rgba(0,0,0,0.06);">
              <table width="100%" cellpadding="0" cellspacing="0" border="0">

                <!-- Envelope icon -->
                <tr>
                  <td align="center" style="padding-bottom:24px;">
                    <div style="width:56px;height:56px;border-radius:50%;background-color:#e8f0fe;display:inline-block;text-align:center;line-height:56px;font-size:26px;">&#9993;</div>
                  </td>
                </tr>

                <!-- Title -->
                <tr>
                  <td align="center">
                    <h1 style="margin:0 0 8px;font-size:22px;font-weight:700;color:#12224F;">Confirm your email</h1>
                    <p style="margin:0 0 24px;font-size:15px;color:#6b7280;">One tap and your Hatiwal account is verified.</p>
                  </td>
                </tr>

                <!-- Body -->
                <tr>
                  <td style="padding:0 0 24px;">
                    <p style="margin:0;font-size:15px;color:#374151;line-height:1.6;">Welcome <strong><%= @email %></strong>,</p>
                    <p style="margin:12px 0 0;font-size:15px;color:#374151;line-height:1.6;">Confirming your email address shows buyers and sellers that this account is real. You can keep using Hatiwal either way &mdash; but a verified account is a trusted one.</p>
                  </td>
                </tr>

                <!-- Button -->
                <tr>
                  <td align="center" style="padding:8px 0 28px;">
                    <a href="<%= confirm_url %>" style="display:inline-block;padding:14px 36px;background-color:#E8B23A;color:#12224F;font-size:15px;font-weight:700;text-decoration:none;border-radius:8px;letter-spacing:0.2px;">Confirm Email</a>
                  </td>
                </tr>

                <!-- URL fallback -->
                <tr>
                  <td style="padding-bottom:24px;">
                    <p style="margin:0;font-size:13px;color:#9ca3af;line-height:1.6;">If the button doesn&rsquo;t work, copy and paste this link into your browser:</p>
                    <p style="margin:6px 0 0;font-size:13px;"><a href="<%= confirm_url %>" style="color:#12224F;word-break:break-all;"><%= confirm_url %></a></p>
                  </td>
                </tr>

                <tr>
                  <td style="border-top:1px solid #f3f4f6;padding-top:20px;">
                    <p style="margin:0;font-size:13px;color:#9ca3af;line-height:1.6;">If you didn&rsquo;t create a Hatiwal account, you can safely ignore this email.</p>
                  </td>
                </tr>

              </table>
            </td>
          </tr>

          <!-- Footer -->
          <tr>
            <td align="center" style="padding-top:24px;">
              <p style="margin:0;font-size:13px;color:#9ca3af;">&copy; <%= Time.current.year %> Hatiwal. All rights reserved.</p>
            </td>
          </tr>

        </table>
      </td>
    </tr>
  </table>
</body>
</html>
