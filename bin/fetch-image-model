#!/usr/bin/env bash
# Search by image (docs/IMAGE_SEARCH.md): downloads the pinned CLIP image model
# into IMAGE_SEARCH_MODEL_DIR (default vendor/image_models) and checks its
# sha256. Run once on a dev machine; the Dockerfile runs it at BUILD time, so a
# production server never downloads a model. Keep these values in step with
# ImageSearch::Embedder (MODEL_ID / MODEL_REVISION / MODEL_FILE).
set -euo pipefail

MODEL_ID="Xenova/clip-vit-base-patch32"
REVISION="6b7c523703ae26e39be4b03774966f8571c7f523"
FILE="onnx/vision_model_quantized.onnx"
SHA256="583fd1110a514667812fee7d684952aaf82a99b959760c8d7dca7e0ab9839299"

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
DIR="${IMAGE_SEARCH_MODEL_DIR:-$ROOT/vendor/image_models}"
DEST="$DIR/$MODEL_ID/$REVISION/$FILE"

if [ -f "$DEST" ] && echo "$SHA256  $DEST" | sha256sum -c --status; then
  echo "image model already present: $DEST"
  exit 0
fi

mkdir -p "$(dirname "$DEST")"
curl -fsSL --retry 3 -o "$DEST.part" "https://huggingface.co/$MODEL_ID/resolve/$REVISION/$FILE"
if ! echo "$SHA256  $DEST.part" | sha256sum -c --status; then
  rm -f "$DEST.part"
  echo "image model checksum mismatch for $FILE" >&2
  exit 1
fi
mv "$DEST.part" "$DEST"
echo "image model fetched: $DEST"
